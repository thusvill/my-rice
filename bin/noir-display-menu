#!/usr/bin/python3
"""Native Noir display profile control center."""

import json
import os
import subprocess
from pathlib import Path

# Niri is Wayland; avoid selecting a stale X11 DISPLAY when the app is spawned
# directly by the compositor keybinding.
if os.environ.get("WAYLAND_DISPLAY"):
    os.environ["GDK_BACKEND"] = "wayland"

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib


CSS = """
* { font-family: Inter, sans-serif; }
window, .background { background: #000000; color: #f3f3f5; }
.header { background: #0c0c0e; border-bottom: 1px solid #222226; }
.brand { color: #eeeeee; font-family: JetBrains Mono, monospace; font-weight: 600; }
.muted { color: #9999a1; font-size: 12px; }
.card { background: #121215; border: 1px solid #222226; border-radius: 10px; }
.title { color: #ffffff; font-size: 22px; font-weight: 700; }
.copy { color: #9999a1; font-size: 12px; }
button.action { background: #eeeeee; color: #000000; border: none; border-radius: 6px; padding: 9px 14px; font-weight: 600; }
button.action:hover { background: #ffffff; }
button.secondary { background: #18181c; color: #dddddf; border: 1px solid #33333a; border-radius: 6px; padding: 9px 14px; }
button.secondary:hover { background: #222228; }
button.profile-selected { background: #eeeeee; color: #000000; border-color: #eeeeee; font-weight: 600; }
button.profile-selected:hover { background: #ffffff; color: #000000; }
.output-name { color: #ffffff; font-family: JetBrains Mono, monospace; font-weight: 600; }
.status { color: #9999a1; font-family: JetBrains Mono, monospace; font-size: 11px; }
"""

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
DISPLAY_STATE = CONFIG / "noir-rice" / "display.json"


class DisplayCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Noir // Display Control Center")
        self.set_default_size(820, 620)
        self.set_position(Gtk.WindowPosition.CENTER)
        provider = Gtk.CssProvider(); provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        root.pack_start(self.header(), False, False, 0)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        body.set_margin_top(28); body.set_margin_bottom(24); body.set_margin_start(32); body.set_margin_end(32)
        root.pack_start(body, True, True, 0)
        title = Gtk.Label(label="Display Profiles", xalign=0); title.get_style_context().add_class("title")
        body.pack_start(title, False, False, 0)
        subtitle = Gtk.Label(label="Apply a monitor layout instantly through Niri.", xalign=0); subtitle.get_style_context().add_class("copy")
        body.pack_start(subtitle, False, False, 0)
        self.output_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        body.pack_start(self.output_box, False, False, 0)
        self.last_output_signature = None
        self.profile_buttons = {}
        profiles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for key, label, callback in (("primary", "Primary only", self.primary_only), ("secondary", "Secondary only", self.secondary_only),
                                     ("mirror", "Mirror", self.mirror), ("extend", "Extend", self.extend)):
            button = Gtk.Button(label=label); button.get_style_context().add_class("secondary")
            button.connect("clicked", callback); profiles.pack_start(button, False, False, 0)
            self.profile_buttons[key] = button
        body.pack_start(profiles, False, False, 0)
        fine = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        detailed = Gtk.Button(label="Fine-tune displays"); detailed.get_style_context().add_class("secondary")
        detailed.connect("clicked", lambda *_: self.launch(["nwg-displays"], "Detailed display settings opened"))
        refresh = Gtk.Button(label="Refresh outputs"); refresh.get_style_context().add_class("secondary")
        refresh.connect("clicked", lambda *_: self.refresh())
        fine.pack_start(detailed, False, False, 0); fine.pack_start(refresh, False, False, 0)
        body.pack_start(fine, False, False, 0)
        self.status = Gtk.Label(label="Ready", xalign=0); self.status.get_style_context().add_class("status")
        body.pack_end(self.status, False, False, 0)
        self.refresh(force=True)
        # Outputs can change asynchronously after an IPC action. Polling keeps
        # cards synchronized with Niri without requiring the user to reopen it.
        GLib.timeout_add(1000, self.poll_outputs)

    def header(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bar.set_margin_start(16); bar.set_margin_end(16); bar.set_margin_top(10); bar.set_margin_bottom(10)
        bar.get_style_context().add_class("header")
        icon = Gtk.Label(label="▦"); icon.get_style_context().add_class("muted"); bar.pack_start(icon, False, False, 0)
        brand = Gtk.Label(label="NOIR // DISPLAY_CONTROL_CENTER", xalign=0); brand.get_style_context().add_class("brand")
        bar.pack_start(brand, True, True, 0)
        return bar

    def outputs(self):
        try:
            result = subprocess.run(["niri", "msg", "--json", "outputs"], capture_output=True, text=True, check=True)
            return json.loads(result.stdout)
        except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
            return {}

    def output_signature(self, data):
        return json.dumps(data, sort_keys=True, separators=(",", ":"))

    def poll_outputs(self):
        self.refresh()
        return True

    def refresh(self, data=None, force=False):
        if data is None:
            data = self.outputs()
        signature = self.output_signature(data)
        if not force and signature == self.last_output_signature:
            return False
        self.last_output_signature = signature
        for child in self.output_box.get_children(): self.output_box.remove(child)
        if not data:
            label = Gtk.Label(label="No Niri outputs found. Run this from inside the active Niri session.", xalign=0)
            label.get_style_context().add_class("copy"); self.output_box.pack_start(label, False, False, 0)
        else:
            for name, raw_output in sorted(data.items()):
                output = raw_output or {}
                logical = output.get("logical") or {}
                modes = output.get("modes") or []
                current = output.get("current_mode", 0)
                mode = modes[current] if isinstance(current, int) and 0 <= current < len(modes) else {}
                state = "enabled" if logical else "disabled"
                text = f"{output.get('make', '')} {output.get('model', '')}  •  {mode.get('width', '?')}×{mode.get('height', '?')}  •  position {logical.get('x', 0)}, {logical.get('y', 0)}  •  {state}"
                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                card.set_margin_top(10); card.set_margin_bottom(10); card.set_margin_start(14); card.set_margin_end(14)
                card.get_style_context().add_class("card")
                title = Gtk.Label(label=name, xalign=0); title.get_style_context().add_class("output-name")
                detail = Gtk.Label(label=text, xalign=0); detail.get_style_context().add_class("copy")
                card.pack_start(title, False, False, 0); card.pack_start(detail, False, False, 0)
                self.output_box.pack_start(card, False, False, 0)
        self.output_box.show_all()
        self.update_profile_selection(data)
        return False

    def update_profile_selection(self, data):
        selected = self.detect_profile(data)
        for key, button in self.profile_buttons.items():
            context = button.get_style_context()
            if key == selected:
                context.add_class("profile-selected")
            else:
                context.remove_class("profile-selected")

    def detect_profile(self, data):
        if not data:
            return None
        names = sorted(data)
        primary = self.primary_name(names)
        enabled = []
        for name in names:
            logical = (data[name] or {}).get("logical") or {}
            if logical:
                enabled.append(name)
        if not enabled:
            return None
        if primary not in enabled:
            return "secondary"
        if len(enabled) == 1:
            return "primary"
        if self.mirror_active():
            return "mirror"
        if len(enabled) == 2 and primary not in enabled:
            return "secondary"
        # Extended layouts have distinct logical X positions. If both outputs
        # overlap without wl-mirror, leave the profile unselected as custom.
        positions = {((data[name] or {}).get("logical") or {}).get("x") for name in enabled}
        return "extend" if len(positions) > 1 else None

    def mirror_active(self):
        return subprocess.run(["pgrep", "-x", "wl-mirror"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0

    def save_profile(self, profile):
        try:
            DISPLAY_STATE.parent.mkdir(parents=True, exist_ok=True)
            DISPLAY_STATE.write_text(json.dumps({"profile": profile}, indent=2) + "\n")
        except OSError as error:
            self.status.set_text(f"Could not save display profile: {error}")

    def run(self, args):
        try:
            subprocess.run(["niri", "msg", *args], check=True, capture_output=True, text=True)
            return True
        except (OSError, subprocess.CalledProcessError) as error:
            self.status.set_text(f"Display error: {error}")
            return False

    def names(self): return sorted(self.outputs().keys())

    def primary_name(self, names):
        return next((name for name in names if name.lower().startswith(("edp", "lvds", "dsi"))), names[0] if names else "")

    def primary_only(self, *_):
        self.save_profile("primary")
        names = self.names(); primary = self.primary_name(names)
        for name in names: self.run(["output", name, "on" if name == primary else "off"])
        if primary: self.run(["output", primary, "position", "set", "0", "0"])
        self.status.set_text(f"Primary display enabled: {primary}; waiting for Niri")

    def secondary_only(self, *_):
        self.save_profile("secondary")
        names = self.names(); primary = self.primary_name(names)
        secondary = next((name for name in names if name != primary), "")
        if not secondary: self.status.set_text("No secondary display is connected"); return
        for name in names: self.run(["output", name, "on" if name == secondary else "off"])
        self.run(["output", secondary, "position", "set", "0", "0"])
        self.status.set_text(f"Secondary display enabled: {secondary}; waiting for Niri")

    def extend(self, *_):
        self.save_profile("extend")
        data = self.outputs(); x = 0
        for name in sorted(data):
            self.run(["output", name, "on"])
            logical = (data[name] or {}).get("logical") or {}
            width = logical.get("width", 1920)
            self.run(["output", name, "position", "set", str(x), "0"]); x += int(width)
        self.status.set_text("Displays extended left to right; waiting for Niri")

    def mirror(self, *_):
        self.save_profile("mirror")
        names = self.names(); primary = self.primary_name(names)
        secondary = next((name for name in names if name != primary), "")
        if not secondary: self.status.set_text("Mirroring needs two displays"); return
        if not shutil_which("wl-mirror"):
            self.status.set_text("Install wl-mirror to use mirroring"); return
        for name in names: self.run(["output", name, "on"])
        subprocess.run(["pkill", "-x", "wl-mirror"], stderr=subprocess.DEVNULL)
        subprocess.Popen(["wl-mirror", "--fullscreen-output", secondary, primary], start_new_session=True)
        self.status.set_text(f"Mirroring {primary} on {secondary}; waiting for Niri")

    def launch(self, command, message):
        try: subprocess.Popen(command, start_new_session=True); self.status.set_text(message)
        except OSError as error: self.status.set_text(str(error))


def shutil_which(command):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        path = Path(directory) / command
        if path.is_file() and os.access(path, os.X_OK): return str(path)
    return None


def main():
    window = DisplayCenter(); window.connect("destroy", Gtk.main_quit); window.show_all(); Gtk.main()


if __name__ == "__main__": main()
