#!/usr/bin/python3
"""Native Noir Settings control center for the Niri rice."""

import os
import json
import re
import shlex
import shutil
import subprocess
import time
from pathlib import Path

# Niri provides a Wayland display; prefer it over a stale X11 DISPLAY value.
if os.environ.get("WAYLAND_DISPLAY"):
    os.environ["GDK_BACKEND"] = "wayland"

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf


HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
WAYBAR = CONFIG / "waybar"  # rollback/reference only
ASTAL = CONFIG / "astal"
ASTAL_STATE = CONFIG / "noir-rice" / "astal.json"
KITTY_CONFIG = CONFIG / "kitty" / "kitty.conf"
NIRI_CONFIG = CONFIG / "niri" / "config.kdl"
SWAYLOCK_CONFIG = CONFIG / "swaylock" / "config"
LOCKSCREEN_STATE = CONFIG / "noir-rice" / "lockscreen.json"
NVIM_STATE = CONFIG / "noir-rice" / "nvim.json"
PALETTE_STATE = CONFIG / "noir-rice" / "palette.json"
WALLPAPER_STATE = CONFIG / "noir-rice" / "wallpaper.json"
LAUNCHER_STATE = CONFIG / "noir-rice" / "launcher.json"
BIN = HOME / ".local" / "bin"
WALLPAPER_DIR = HOME / "Pictures" / "Wallpapers"


CSS = """
* { font-family: Inter, sans-serif; }
window, .background { background: #000000; color: #f3f3f5; }
.header { background: #0c0c0e; border-bottom: 1px solid #222226; }
.brand { color: #eeeeee; font-family: JetBrains Mono, monospace; font-weight: 600; }
.muted { color: #888890; }
.sidebar { background: #0c0c0e; border-right: 1px solid #222226; }
.section-label { color: #66666e; font-size: 10px; font-weight: 700; }
button.nav { background: transparent; border: 1px solid transparent; border-radius: 8px; color: #9999a1; padding: 10px 12px; }
button.nav:hover { background: #18181c; color: #eeeeee; }
button.nav.active { background: #18181c; border-color: #33333a; color: #ffffff; }
.content { background: #000000; }
.title { color: #ffffff; font-size: 22px; font-weight: 700; }
.subtitle { color: #9999a1; font-size: 12px; }
.card { background: #121215; border: 1px solid #222226; border-radius: 10px; }
.card-title { color: #eeeeee; font-weight: 600; }
.card-copy { color: #9999a1; font-size: 12px; }
expander.section-expander { margin-top: 4px; margin-bottom: 4px; }
expander.section-expander title { color: #eeeeee; font-weight: 600; padding: 4px 8px; }
expander.section-expander title:hover { color: #ffffff; }
button.action { background: #eeeeee; color: #000000; border: none; border-radius: 6px; padding: 8px 14px; font-weight: 600; }
button.action:hover { background: #ffffff; }
button.secondary { background: #18181c; color: #dddddf; border: 1px solid #33333a; border-radius: 6px; padding: 8px 14px; }
button.secondary:hover { background: #222228; }
.status { color: #9999a1; font-family: JetBrains Mono, monospace; font-size: 11px; }
"""


class NoirSettings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Noir // Rice Control Center")
        self.set_default_size(1080, 700)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(0)
        self.live_timers = {}
        self.load_css()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        root.pack_start(self.header(), False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        root.pack_start(body, True, True, 0)
        sidebar = self.sidebar()
        body.pack_start(sidebar, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_margin_top(28)
        self.stack.set_margin_bottom(28)
        self.stack.set_margin_start(32)
        self.stack.set_margin_end(32)
        content = Gtk.Box()
        content.get_style_context().add_class("content")
        content.pack_start(self.stack, True, True, 0)
        body.pack_start(content, True, True, 0)

        self.add_page("wallpaper", "Wallpaper", "Choose, dither, and preview your desktop wallpaper", self.wallpaper_page())
        self.add_page("appearance", "Appearance", "Use wallpaper colors across the Noir rice", self.appearance_page())
        self.add_page("launcher", "Launcher", "Calculator and currency conversion", self.launcher_page())
        self.add_page("astal", "Astal Shell", "Configure the active AGS bar and native popups", self.astal_page())
        self.add_page("terminal", "Terminal", "Configure the Noir Kitty terminal", self.terminal_page())
        self.add_page("editor", "Editor", "Configure the Noir Neovim theme", self.editor_page())
        self.add_page("display", "Displays", "Choose primary, secondary, mirror, or extend", self.display_page())
        self.add_page("lock", "Lock Screen", "Customize the Swaylock indicator", self.lockscreen_page())
        self.add_page("niri", "Window Manager", "Niri layout and keybinding configuration", self.niri_page())
        self.add_page("presets", "Presets & Dotfiles", "Open, inspect, and reload rice configuration", self.presets_page())
        self.add_page("diagnostics", "Diagnostics", "Validate dependencies and active configuration", self.diagnostics_page())
        self.show_page("wallpaper")

    def load_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def header(self):
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.set_margin_start(16); header.set_margin_end(16)
        header.set_margin_top(10); header.set_margin_bottom(10)
        header.get_style_context().add_class("header")
        terminal = Gtk.Label(label="▣")
        terminal.get_style_context().add_class("muted")
        header.pack_start(terminal, False, False, 0)
        brand = Gtk.Label(label="NOIR // RICE_CONTROL_CENTER", xalign=0)
        brand.get_style_context().add_class("brand")
        header.pack_start(brand, True, True, 0)
        profile = Gtk.Label(label="●  PROFILE: MONOCHROME_NOIR")
        profile.get_style_context().add_class("muted")
        header.pack_end(profile, False, False, 0)
        return header

    def sidebar(self):
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        side.set_size_request(235, -1)
        side.set_margin_top(18); side.set_margin_start(12); side.set_margin_end(12)
        side.get_style_context().add_class("sidebar")
        label = Gtk.Label(label="MODULES", xalign=0)
        label.set_margin_start(12); label.set_margin_bottom(8)
        label.get_style_context().add_class("section-label")
        side.pack_start(label, False, False, 0)
        self.settings_search = Gtk.SearchEntry()
        self.settings_search.set_placeholder_text("Search settings")
        self.settings_search.set_margin_start(8); self.settings_search.set_margin_end(8); self.settings_search.set_margin_bottom(8)
        self.settings_search.connect("search-changed", self.filter_pages)
        side.pack_start(self.settings_search, False, False, 0)
        pages = [("wallpaper", "▧  Wallpaper"), ("appearance", "Appearance"), ("launcher", "Launcher"), ("astal", "▤  Astal Shell"), ("terminal", "Terminal"), ("editor", "Editor"),
                 ("display", "▦  Displays"), ("lock", "◉  Lock Screen"), ("niri", "▦  Window Manager"),
                 ("presets", "Settings  Presets & Dotfiles"), ("diagnostics", "Diagnostics")]
        self.nav_buttons = {}
        self.nav_titles = {}
        for name, title in pages:
            button = Gtk.Button(label=title)
            button.set_halign(Gtk.Align.FILL)
            button.get_style_context().add_class("nav")
            button.connect("clicked", lambda _button, page=name: self.show_page(page))
            self.nav_buttons[name] = button
            self.nav_titles[name] = title
            side.pack_start(button, False, False, 0)
        side.pack_end(self.status_label(), False, False, 12)
        return side

    def filter_pages(self, entry):
        query = entry.get_text().strip().lower()
        active = self.stack.get_visible_child_name()
        for name, button in self.nav_buttons.items():
            visible = not query or query in self.nav_titles[name].lower() or name in query
            if name == active:
                visible = True
            button.set_visible(visible)

    def status_label(self):
        self.status = Gtk.Label(label="Ready", xalign=0)
        self.status.set_line_wrap(True)
        self.status.set_margin_start(12)
        self.status.get_style_context().add_class("status")
        return self.status

    def add_page(self, name, title, subtitle, widget):
        self.make_sections_collapsible(widget)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        title_label = Gtk.Label(label=title, xalign=0)
        title_label.get_style_context().add_class("title")
        subtitle_label = Gtk.Label(label=subtitle, xalign=0)
        subtitle_label.get_style_context().add_class("subtitle")
        heading.pack_start(title_label, False, False, 0)
        heading.pack_start(subtitle_label, False, False, 0)
        page.pack_start(heading, False, False, 0)

        # Keep previews visible while the editable sections below scroll.
        previews = [child for child in widget.get_children()
                    if child.get_style_context().has_class("preview-card")]
        if previews:
            preview_bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            for preview in previews:
                widget.remove(preview)
                preview_bar.pack_start(preview, False, False, 0)
            page.pack_start(preview_bar, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_shadow_type(Gtk.ShadowType.NONE)
        scroller.add(widget)
        page.pack_start(scroller, True, True, 0)
        self.stack.add_named(page, name)

    def make_sections_collapsible(self, page_box):
        """Turn every top-level card on a settings page into an expander.

        The controls remain exactly the same widgets, so their live-preview
        callbacks and state are preserved.  Only the presentation container is
        changed, and all sections start open for a familiar first-run view.
        """
        for child in list(page_box.get_children()):
            if child.get_style_context().has_class("preview-card"):
                continue
            if not child.get_style_context().has_class("card"):
                continue

            title = "Section"
            title_label = None
            for nested in child.get_children():
                if not isinstance(nested, Gtk.Label):
                    continue
                if nested.get_style_context().has_class("card-title"):
                    title = nested.get_text() or title
                    title_label = nested
                    break

            page_box.remove(child)
            expander = Gtk.Expander(label=title)
            expander.set_expanded(True)
            expander.set_hexpand(True)
            expander.set_spacing(4)
            expander.get_style_context().add_class("section-expander")
            if title_label is not None:
                # The expander title replaces the duplicate in-card heading.
                title_label.set_no_show_all(True)
                title_label.hide()
            expander.add(child)
            page_box.pack_start(expander, False, False, 0)

    def show_page(self, name):
        self.stack.set_visible_child_name(name)
        for page, button in self.nav_buttons.items():
            button.get_style_context().remove_class("active")
            if page == name:
                button.get_style_context().add_class("active")

    def card(self, title, copy, buttons):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(14); box.set_margin_bottom(14)
        box.set_margin_start(16); box.set_margin_end(16)
        box.get_style_context().add_class("card")
        name = Gtk.Label(label=title, xalign=0); name.get_style_context().add_class("card-title")
        desc = Gtk.Label(label=copy, xalign=0); desc.set_line_wrap(True); desc.get_style_context().add_class("card-copy")
        box.pack_start(name, False, False, 0); box.pack_start(desc, False, False, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, callback, primary in buttons:
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("action" if primary else "secondary")
            button.connect("clicked", callback)
            row.pack_start(button, False, False, 0)
        box.pack_start(row, False, False, 4)
        return box

    def page_box(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_vexpand(True)
        return box

    def launch(self, command, message, env=None):
        try:
            subprocess.Popen(command, env=env, start_new_session=True)
            self.set_status(message)
        except Exception as error:
            self.set_status(f"Error: {error}")

    def local(self, name, *args):
        path = BIN / name
        return [str(path if path.exists() else name), *args]

    def set_status(self, message):
        self.status.set_text(message)

    def schedule_live(self, name, callback, delay=650):
        """Debounce live previews so typing does not restart desktop services."""
        source_id = self.live_timers.get(name, 0)
        if source_id:
            GLib.source_remove(source_id)
        self.live_timers[name] = GLib.timeout_add(delay, self.run_live, name, callback)

    def run_live(self, name, callback):
        self.live_timers[name] = 0
        callback()
        return False

    def wallpaper_page(self):
        box = self.page_box()
        source_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.wallpaper_source = Gtk.FileChooserButton(title="Choose source image", action=Gtk.FileChooserAction.OPEN)
        image_filter = Gtk.FileFilter(); image_filter.set_name("Images")
        for pattern in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
            image_filter.add_pattern(pattern)
        self.wallpaper_source.add_filter(image_filter)
        source_row.pack_start(self.wallpaper_source, True, True, 0)
        select_button = Gtk.Button(label="Wallpaper selector")
        select_button.get_style_context().add_class("secondary")
        select_button.connect("clicked", lambda *_: self.launch(self.local("noir-wallpaper", "select"), "Wallpaper selector opened"))
        source_row.pack_start(select_button, False, False, 0)
        apply_button = Gtk.Button(label="Apply selected wallpaper")
        apply_button.get_style_context().add_class("action")
        apply_button.connect("clicked", self.apply_selected_wallpaper)
        source_row.pack_start(apply_button, False, False, 0)

        self.wallpaper_search = Gtk.SearchEntry()
        self.wallpaper_search.set_placeholder_text("Search available wallpapers…")
        self.wallpaper_search.connect("search-changed", self.filter_wallpapers)
        grid_scroll = Gtk.ScrolledWindow()
        grid_scroll.set_min_content_height(190); grid_scroll.set_max_content_height(240)
        self.wallpaper_scroll = grid_scroll
        self.wallpaper_grid = Gtk.FlowBox()
        self.wallpaper_grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.wallpaper_grid.set_max_children_per_line(5); self.wallpaper_grid.set_min_children_per_line(2)
        self.wallpaper_grid.set_column_spacing(8); self.wallpaper_grid.set_row_spacing(8)
        grid_scroll.add(self.wallpaper_grid)
        self.wallpaper_items = []
        self.wallpaper_render_source_id = 0
        self.wallpaper_render_queue = []
        self.wallpaper_adjustment = grid_scroll.get_vadjustment()
        self.wallpaper_adjustment.connect("value-changed", self.queue_visible_wallpapers)
        self.wallpaper_adjustment.connect("changed", self.queue_visible_wallpapers)

        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.dither_enabled = Gtk.CheckButton(label="Apply ImageMagick dithering when wallpaper is applied")
        dither_state = self.wallpaper_automation_state()
        self.dither_enabled.set_active(bool(dither_state.get("dither_enabled", False)))
        controls.pack_start(self.dither_enabled, False, False, 0)
        dither_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.dither_colors = Gtk.SpinButton.new_with_range(2, 256, 1)
        self.dither_colors.set_value(float(dither_state.get("dither_colors", 16)))
        self.dither_method = Gtk.ComboBoxText()
        for method, label in (("FloydSteinberg", "Floyd–Steinberg"), ("Riemersma", "Riemersma"), ("Ordered", "Ordered"), ("None", "Color reduction only")):
            self.dither_method.append(method, label)
        self.dither_method.set_active_id(dither_state.get("dither_method", "FloydSteinberg"))
        self.dither_pattern = Gtk.ComboBoxText()
        for pattern in ("o4x4", "o8x8", "h4x4a", "h6x6a"):
            self.dither_pattern.append(pattern, pattern)
        self.dither_pattern.set_active_id(dither_state.get("dither_pattern", "o8x8"))
        dither_row.pack_start(self.waybar_field("Color levels", self.dither_colors), True, True, 0)
        dither_row.pack_start(self.waybar_field("Method", self.dither_method), True, True, 0)
        dither_row.pack_start(self.waybar_field("Ordered pattern", self.dither_pattern), True, True, 0)
        controls.pack_start(dither_row, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        convert = Gtk.Button(label="Apply selected wallpaper")
        convert.get_style_context().add_class("action"); convert.connect("clicked", self.apply_selected_wallpaper)
        random_button = Gtk.Button(label="Random wallpaper")
        random_button.get_style_context().add_class("secondary"); random_button.connect("clicked", self.random_wallpaper)
        favorite = Gtk.Button(label="Favorite selected")
        favorite.get_style_context().add_class("secondary")
        favorite.connect("clicked", lambda *_: self.launch(self.local("noir-wallpaper", "favorite", self.wallpaper_source.get_filename() or ""), "Wallpaper favorite saved"))
        buttons.pack_start(convert, False, False, 0); buttons.pack_start(random_button, False, False, 0); buttons.pack_start(favorite, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="WALLPAPER PROCESSING", xalign=0); title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="Click a thumbnail to preview it. The original image stays untouched; enabling dithering creates a cached ImageMagick copy for the active wallpaper.", xalign=0); copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)
        card.pack_start(source_row, False, False, 0); card.pack_start(controls, False, False, 0); card.pack_start(buttons, False, False, 0)
        box.pack_start(card, False, False, 0)

        gallery = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        gallery.set_margin_start(16); gallery.set_margin_end(16)
        gallery.get_style_context().add_class("card")
        gallery_title = Gtk.Label(label="AVAILABLE WALLPAPERS", xalign=0); gallery_title.get_style_context().add_class("card-title")
        self.gallery_status = Gtk.Label(label="Loading thumbnails…", xalign=0); self.gallery_status.get_style_context().add_class("muted")
        gallery.pack_start(gallery_title, False, False, 0)
        gallery.pack_start(self.gallery_status, False, False, 0)
        gallery.pack_start(self.wallpaper_search, False, False, 0)
        gallery.pack_start(grid_scroll, True, True, 0)
        box.pack_start(gallery, False, False, 0)
        self.populate_wallpapers()

        self.wallpaper_source.connect("file-set", lambda *_: self.refresh_wallpaper_preview())
        self.dither_enabled.connect("toggled", self.save_wallpaper_dither)
        for widget in (self.dither_colors, self.dither_method, self.dither_pattern):
            signal = "value-changed" if isinstance(widget, Gtk.SpinButton) else "changed"
            widget.connect(signal, self.save_wallpaper_dither)

        preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        preview_card.set_margin_start(16); preview_card.set_margin_end(16); preview_card.set_margin_bottom(14)
        preview_card.get_style_context().add_class("card")
        preview_card.get_style_context().add_class("preview-card")
        preview_title = Gtk.Label(label="LIVE WALLPAPER PREVIEW", xalign=0); preview_title.get_style_context().add_class("card-title")
        self.wallpaper_preview = Gtk.Image(); self.wallpaper_preview.set_size_request(-1, 230)
        preview_card.pack_start(preview_title, False, False, 0); preview_card.pack_start(self.wallpaper_preview, True, True, 0)
        box.pack_start(preview_card, True, True, 0)
        box.pack_start(self.card("WALLPAPER DIRECTORY", "Noir looks for images in ~/Pictures/Wallpapers.", [
            ("Open folder", lambda *_: self.launch(["kitty", "--directory", str(HOME / "Pictures" / "Wallpapers")], "Wallpaper folder opened"), True),
            ("Start slideshow", lambda *_: self.launch(self.local("noir-wallpaper", "slideshow", "300"), "Wallpaper slideshow started"), False),
            ("Stop slideshow", lambda *_: self.launch(self.local("noir-wallpaper", "stop-slideshow"), "Wallpaper slideshow stopped"), False),
        ]), False, False, 0)
        self.refresh_wallpaper_preview()
        return box

    def wallpaper_palette_state(self):
        try:
            return json.loads(PALETTE_STATE.read_text())
        except (OSError, json.JSONDecodeError):
            return {"enabled": False, "mode": "accent"}

    def wallpaper_automation_state(self):
        try:
            return json.loads(WALLPAPER_STATE.read_text())
        except (OSError, json.JSONDecodeError):
            return {"random_on_startup": False, "cycle_enabled": False, "interval_seconds": 1800,
                    "dither_enabled": False, "dither_colors": 16, "dither_method": "FloydSteinberg",
                    "dither_pattern": "o8x8"}

    def appearance_page(self):
        state = self.wallpaper_palette_state()
        palette_defaults = {
            "readable": (78, 70, 90, True), "balanced": (72, 82, 72, True),
            "vivid": (64, 100, 82, True), "muted": (82, 38, 78, True),
        }.get(state.get("style", "readable"), (78, 70, 90, True))
        box = self.page_box()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="WALLPAPER COLOR SCHEME", xalign=0); title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="Extract colors from the active wallpaper and apply them to the Noir desktop, Waybar, Kitty, Neovim, and notifications.", xalign=0)
        copy.set_line_wrap(True); copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)

        self.palette_enabled = Gtk.CheckButton(label="Use colors extracted from the active wallpaper")
        self.palette_enabled.set_active(bool(state.get("enabled", False)))
        card.pack_start(self.palette_enabled, False, False, 5)

        self.palette_mode = Gtk.ComboBoxText()
        for mode, label in (
            ("accent", "Accent only — keep Noir backgrounds"),
            ("background", "Background and accent"),
            ("full", "Full wallpaper palette"),
        ):
            self.palette_mode.append(mode, label)
        self.palette_mode.set_active_id(state.get("mode", "accent"))
        card.pack_start(self.waybar_field("Wallpaper color mode", self.palette_mode), False, False, 0)

        self.palette_style = Gtk.ComboBoxText()
        for style, label in (
            ("readable", "Readable — strongest contrast"),
            ("balanced", "Balanced — color and contrast"),
            ("vivid", "Vivid — strongest color"),
            ("muted", "Muted — restrained color"),
        ):
            self.palette_style.append(style, label)
        self.palette_style.set_active_id(state.get("style", "readable"))
        card.pack_start(self.waybar_field("Palette style", self.palette_style), False, False, 0)

        self.palette_darkness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 92, 1)
        self.palette_darkness.set_value(float(state.get("darkness", palette_defaults[0])))
        self.palette_darkness.set_draw_value(True); self.palette_darkness.set_digits(0)
        card.pack_start(self.waybar_field("Background darkness", self.palette_darkness), False, False, 0)

        self.palette_strength = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.palette_strength.set_value(float(state.get("accent_strength", palette_defaults[1])))
        self.palette_strength.set_draw_value(True); self.palette_strength.set_digits(0)
        card.pack_start(self.waybar_field("Accent color intensity", self.palette_strength), False, False, 0)

        self.palette_contrast = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.palette_contrast.set_value(float(state.get("contrast_boost", palette_defaults[2])))
        self.palette_contrast.set_draw_value(True); self.palette_contrast.set_digits(0)
        card.pack_start(self.waybar_field("Contrast boost", self.palette_contrast), False, False, 0)

        self.palette_high_contrast = Gtk.CheckButton(label="Force high-contrast text and controls")
        self.palette_high_contrast.set_active(bool(state.get("high_contrast", palette_defaults[3])))
        card.pack_start(self.palette_high_contrast, False, False, 2)

        apply_button = Gtk.Button(label="Apply wallpaper color scheme")
        apply_button.get_style_context().add_class("action")
        apply_button.connect("clicked", self.apply_wallpaper_palette)
        card.pack_start(apply_button, False, False, 5)
        box.pack_start(card, False, False, 0)

        automation = self.wallpaper_automation_state()
        wallpaper_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        wallpaper_card.set_margin_top(0); wallpaper_card.set_margin_bottom(14); wallpaper_card.set_margin_start(16); wallpaper_card.set_margin_end(16)
        wallpaper_card.get_style_context().add_class("card")
        wallpaper_title = Gtk.Label(label="WALLPAPER AUTOMATION", xalign=0); wallpaper_title.get_style_context().add_class("card-title")
        wallpaper_copy = Gtk.Label(label="Choose what happens when the Niri session starts and how often the wallpaper changes.", xalign=0)
        wallpaper_copy.set_line_wrap(True); wallpaper_copy.get_style_context().add_class("card-copy")
        wallpaper_card.pack_start(wallpaper_title, False, False, 0); wallpaper_card.pack_start(wallpaper_copy, False, False, 0)
        self.wallpaper_random_startup = Gtk.CheckButton(label="Use a random wallpaper on startup")
        self.wallpaper_random_startup.set_active(bool(automation.get("random_on_startup", False)))
        self.wallpaper_cycle = Gtk.CheckButton(label="Cycle wallpapers automatically")
        self.wallpaper_cycle.set_active(bool(automation.get("cycle_enabled", False)))
        self.wallpaper_interval = Gtk.SpinButton.new_with_range(1, 1440, 1)
        self.wallpaper_interval.set_value(max(1, float(automation.get("interval_seconds", 1800)) / 60))
        wallpaper_card.pack_start(self.wallpaper_random_startup, False, False, 2)
        wallpaper_card.pack_start(self.wallpaper_cycle, False, False, 2)
        wallpaper_card.pack_start(self.waybar_field("Cycle interval (minutes)", self.wallpaper_interval), False, False, 0)
        wallpaper_apply = Gtk.Button(label="Save wallpaper automation")
        wallpaper_apply.get_style_context().add_class("action")
        wallpaper_apply.connect("clicked", self.save_wallpaper_automation)
        wallpaper_card.pack_start(wallpaper_apply, False, False, 5)
        box.pack_start(wallpaper_card, False, False, 0)
        for widget in (self.wallpaper_random_startup, self.wallpaper_cycle):
            widget.connect("toggled", lambda *_: self.save_wallpaper_automation())
        self.wallpaper_interval.connect("value-changed", lambda *_: self.save_wallpaper_automation())

        preview = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        preview.set_margin_start(16); preview.set_margin_end(16); preview.set_margin_bottom(14)
        preview.get_style_context().add_class("card")
        preview.get_style_context().add_class("preview-card")
        preview_title = Gtk.Label(label="EXTRACTED PALETTE", xalign=0); preview_title.get_style_context().add_class("card-title")
        preview_copy = Gtk.Label(label="The palette updates whenever a new wallpaper is applied while this setting is enabled.", xalign=0)
        preview_copy.set_line_wrap(True); preview_copy.get_style_context().add_class("card-copy")
        self.palette_preview = Gtk.DrawingArea(); self.palette_preview.set_size_request(-1, 72)
        self.palette_preview.connect("draw", self.draw_palette_preview)
        preview.pack_start(preview_title, False, False, 0)
        preview.pack_start(preview_copy, False, False, 0)
        preview.pack_start(self.palette_preview, False, False, 0)
        box.pack_start(preview, False, False, 0)

        self.palette_enabled.connect("toggled", lambda *_: self.apply_wallpaper_palette())
        self.palette_mode.connect("changed", lambda *_: self.apply_wallpaper_palette() if self.palette_enabled.get_active() else None)
        self.palette_style.connect("changed", self.palette_style_changed)
        for widget in (self.palette_darkness, self.palette_strength, self.palette_contrast):
            widget.connect("value-changed", lambda *_: self.schedule_live("palette", self.apply_wallpaper_palette, 650) if self.palette_enabled.get_active() else None)
        self.palette_high_contrast.connect("toggled", lambda *_: self.schedule_live("palette", self.apply_wallpaper_palette, 650) if self.palette_enabled.get_active() else None)
        return box

    def palette_style_changed(self, *_):
        defaults = {
            "readable": (78, 70, 90, True), "balanced": (72, 82, 72, True),
            "vivid": (64, 100, 82, True), "muted": (82, 38, 78, True),
        }.get(self.palette_style.get_active_id(), (78, 70, 90, True))
        self.palette_darkness.set_value(defaults[0])
        self.palette_strength.set_value(defaults[1])
        self.palette_contrast.set_value(defaults[2])
        self.palette_high_contrast.set_active(defaults[3])
        if self.palette_enabled.get_active():
            self.schedule_live("palette", self.apply_wallpaper_palette, 650)

    def save_wallpaper_dither(self, *_):
        self.save_wallpaper_automation(manage_cycle=False)

    def save_wallpaper_automation(self, *_, manage_cycle=True):
        state = {
            "random_on_startup": self.wallpaper_random_startup.get_active(),
            "cycle_enabled": self.wallpaper_cycle.get_active(),
            "interval_seconds": int(self.wallpaper_interval.get_value() * 60),
            "dither_enabled": self.dither_enabled.get_active() if hasattr(self, "dither_enabled") else False,
            "dither_colors": int(self.dither_colors.get_value()) if hasattr(self, "dither_colors") else 16,
            "dither_method": self.dither_method.get_active_id() if hasattr(self, "dither_method") else "FloydSteinberg",
            "dither_pattern": self.dither_pattern.get_active_id() if hasattr(self, "dither_pattern") else "o8x8",
        }
        try:
            WALLPAPER_STATE.parent.mkdir(parents=True, exist_ok=True)
            WALLPAPER_STATE.write_text(json.dumps(state, indent=2) + "\n")
            if manage_cycle:
                if state["cycle_enabled"]:
                    self.launch(self.local("noir-wallpaper", "start-cycle", str(state["interval_seconds"])),
                                f"Wallpaper cycle enabled: every {int(self.wallpaper_interval.get_value())} minutes")
                else:
                    self.launch(self.local("noir-wallpaper", "stop-cycle"), "Wallpaper cycle disabled")
            self.set_status("Wallpaper settings saved automatically")
        except OSError as error:
            self.set_status(f"Wallpaper automation error: {error}")

    def apply_wallpaper_palette(self, *_):
        try:
            if not self.palette_enabled.get_active():
                self.launch(self.local("noir-palette", "disable"), "Wallpaper color scheme disabled")
                return
            state = self.wallpaper_palette_state()
            state.update({
                "enabled": True,
                "mode": self.palette_mode.get_active_id() or "accent",
                "style": self.palette_style.get_active_id() or "readable",
                "darkness": int(self.palette_darkness.get_value()),
                "accent_strength": int(self.palette_strength.get_value()),
                "contrast_boost": int(self.palette_contrast.get_value()),
                "high_contrast": self.palette_high_contrast.get_active(),
            })
            PALETTE_STATE.parent.mkdir(parents=True, exist_ok=True)
            PALETTE_STATE.write_text(json.dumps(state, indent=2) + "\n")
            self.launch(self.local("noir-palette", "apply"),
                        f"Applying wallpaper palette: {state['style']}")
            GLib.timeout_add(900, self.refresh_palette_preview)
        except Exception as error:
            self.set_status(f"Wallpaper palette error: {error}")

    def refresh_palette_preview(self):
        self.palette_preview.queue_draw()
        return False

    def draw_palette_preview(self, _area, context):
        allocation = self.palette_preview.get_allocation()
        width, height = allocation.width, allocation.height
        context.set_source_rgb(0, 0, 0); context.paint()
        state = self.wallpaper_palette_state()
        colors = state.get("colors", {})
        swatches = [colors.get(key, fallback) for key, fallback in (
            ("background", "#000000"), ("surface", "#121215"), ("accent", "#cfcfcf"),
            ("foreground", "#f3f3f5"), ("muted", "#9999a1"), ("border", "#29292f"),
        )]
        swatch_width = max(1, width / len(swatches))
        for index, value in enumerate(swatches):
            red, green, blue, _alpha = self.preview_color(self.entry(value), "000000")
            context.set_source_rgb(red, green, blue)
            context.rectangle(index * swatch_width, 0, swatch_width + 1, height)
            context.fill()
        return False

    def launcher_state(self):
        defaults = {
            "enabled": True, "show_calculator": True, "show_currency": True,
            "prompt": "Launch / Calculate: ", "width": 600, "height": 360, "max_results": 40,
            "currency": "LKR",
            "rates": {"LKR": 1.0, "USD": 0.0031, "EUR": 0.0029, "GBP": 0.0025, "INR": 0.28, "JPY": 0.48},
        }
        try:
            state = json.loads(LAUNCHER_STATE.read_text())
            defaults.update(state)
            defaults["rates"].update(state.get("rates", {}))
        except (OSError, json.JSONDecodeError):
            pass
        return defaults

