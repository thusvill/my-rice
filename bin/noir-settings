    def draw_launcher_preview(self, _area, context):
        allocation = self.launcher_preview.get_allocation()
        width, height = allocation.width, allocation.height
        context.set_source_rgb(0.0, 0.0, 0.0); context.paint()
        outer_width = min(width - 28, max(260, self.launcher_width.get_value() * 0.72))
        outer_height = min(height - 18, max(110, self.launcher_height.get_value() * 0.40))
        x, y = (width - outer_width) / 2, (height - outer_height) / 2
        context.set_source_rgb(0.05, 0.05, 0.06); context.rectangle(x, y, outer_width, outer_height); context.fill()
        context.set_source_rgb(0.16, 0.16, 0.18); context.rectangle(x, y, outer_width, 1); context.fill()
        context.set_source_rgb(0.07, 0.07, 0.08); context.rectangle(x + 10, y + 10, outer_width - 20, 27); context.fill()
        context.set_source_rgb(0.95, 0.95, 0.96); context.set_font_size(11)
        context.move_to(x + 18, y + 28); context.show_text(self.launcher_prompt.get_text() or "Launch / Calculate: ")
        context.set_source_rgb(0.80, 0.80, 0.82); context.move_to(x + 18, y + 59); context.show_text("Calculate expression")
        context.set_source_rgb(0.58, 0.58, 0.62); context.move_to(x + 18, y + 79); context.show_text("100 USD to LKR   =   live conversion result")
        context.set_source_rgb(0.40, 0.40, 0.44); context.move_to(x + 18, y + 99); context.show_text(f"{int(self.launcher_results.get_value())} app results maximum")
        return False

    def save_launcher(self, *_):
        base = self.launcher_currency.get_text().strip().upper()
        if not re.fullmatch(r"[A-Z]{3}", base):
            self.set_status("Base currency must be a three-letter code such as LKR")
            return
        rates = {base: 1.0}
        for item in self.launcher_rates.get_text().split(","):
            item = item.strip()
            if not item:
                continue
            match = re.fullmatch(r"([A-Za-z]{3})\s*=\s*([0-9]+(?:\.[0-9]+)?)", item)
            if not match or float(match.group(2)) <= 0:
                self.set_status(f"Invalid currency rate: {item}")
                return
            rates[match.group(1).upper()] = float(match.group(2))
        try:
            LAUNCHER_STATE.parent.mkdir(parents=True, exist_ok=True)
            LAUNCHER_STATE.write_text(json.dumps({
                "enabled": self.launcher_enabled.get_active(),
                "show_calculator": self.launcher_calculator.get_active(),
                "show_currency": self.launcher_currency_enabled.get_active(),
                "prompt": self.launcher_prompt.get_text().strip() or "Launch / Calculate: ",
                "width": int(self.launcher_width.get_value()),
                "height": int(self.launcher_height.get_value()),
                "max_results": int(self.launcher_results.get_value()),
                "currency": base, "rates": rates,
            }, indent=2) + "\n")
            self.set_status("Launcher settings saved")
        except OSError as error:
            self.set_status(f"Launcher settings error: {error}")

    def populate_wallpapers(self):
        if not WALLPAPER_DIR.exists():
            self.wallpaper_paths = []
            self.gallery_status.set_text("Wallpaper directory not found")
            return
        self.all_wallpaper_paths = [path for path in sorted(WALLPAPER_DIR.iterdir(), key=lambda item: item.name.lower())
                                    if path.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")]
        self.rebuild_wallpaper_grid()

    def rebuild_wallpaper_grid(self):
        if hasattr(self, "wallpaper_source_id") and self.wallpaper_source_id:
            GLib.source_remove(self.wallpaper_source_id)
        if self.wallpaper_render_source_id:
            GLib.source_remove(self.wallpaper_render_source_id)
            self.wallpaper_render_source_id = 0
        query = self.wallpaper_search.get_text().lower().strip()
        matches = [path for path in self.all_wallpaper_paths if not query or query in path.name.lower()]
        # Keep the widget count bounded, but do not decode these files yet.  The
        # gallery renderer below only decodes cards close to the viewport.
        self.wallpaper_paths = matches[:120]
        self.wallpaper_items = []
        for child in self.wallpaper_grid.get_children(): self.wallpaper_grid.remove(child)
        self.gallery_status.set_text(f"Showing {len(self.wallpaper_paths)} of {len(matches)} matches • search to narrow results")
        for path in self.wallpaper_paths:
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_size_request(150, 112)
            button.set_tooltip_text(path.name)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            image = Gtk.Image()
            image.set_size_request(142, 82)
            label = Gtk.Label(label=path.stem[:22], xalign=0.5)
            label.get_style_context().add_class("muted")
            content.pack_start(image, False, False, 0); content.pack_start(label, False, False, 0)
            button.add(content)
            button.connect("clicked", self.choose_wallpaper, str(path))
            self.wallpaper_grid.add(button)
            self.wallpaper_items.append({"button": button, "image": image, "path": path,
                                         "loaded": False, "wanted": False})
        self.wallpaper_grid.show_all()
        self.wallpaper_grid.queue_resize()
        GLib.idle_add(self.queue_visible_wallpapers)

    def queue_visible_wallpapers(self, *_):
        if not self.wallpaper_items:
            return False
        adjustment = self.wallpaper_adjustment
        top = adjustment.get_value()
        bottom = top + adjustment.get_page_size()
        # Preload roughly two rows above/below the viewport, enough for smooth
        # scrolling without retaining a gallery-sized pixbuf cache.
        preload = 220
        wanted = []
        for item in self.wallpaper_items:
            allocation = item["button"].get_allocation()
            item_top = allocation.y
            item_bottom = item_top + max(allocation.height, 112)
            should_load = item_bottom >= top - preload and item_top <= bottom + preload
            item["wanted"] = should_load
            if should_load and not item["loaded"]:
                wanted.append(item)
            elif not should_load and item["loaded"]:
                # Dropping the Gtk.Image reference releases the decoded pixbuf.
                item["image"].clear()
                item["loaded"] = False
        self.wallpaper_render_queue = wanted
        if self.wallpaper_render_queue and not self.wallpaper_render_source_id:
            self.wallpaper_render_source_id = GLib.idle_add(self.render_wallpaper_thumbnail)
        return False

    def render_wallpaper_thumbnail(self):
        self.wallpaper_render_source_id = 0
        while self.wallpaper_render_queue:
            item = self.wallpaper_render_queue.pop(0)
            if not item["wanted"] or item["loaded"]:
                continue
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(item["path"]), 142, 82, True)
                item["image"].set_from_pixbuf(pixbuf)
                item["loaded"] = True
            except Exception:
                item["loaded"] = True
            # Decode one file per main-loop turn so scrolling and search stay responsive.
            if self.wallpaper_render_queue:
                self.wallpaper_render_source_id = GLib.idle_add(self.render_wallpaper_thumbnail)
            return False
        return False

    def filter_wallpapers(self, *_):
        self.rebuild_wallpaper_grid()

    def choose_wallpaper(self, _button, path):
        self.wallpaper_source.set_filename(path)
        self.refresh_wallpaper_preview()
        self.set_status(f"Selected wallpaper: {Path(path).name}")

    def apply_selected_wallpaper(self, *_):
        source = self.wallpaper_source.get_filename()
        if not source:
            self.set_status("Select a wallpaper thumbnail first")
            return
        self.launch(self.local("noir-wallpaper", "set", source),
                    f"Applied wallpaper: {Path(source).name}")

    def random_wallpaper(self, *_):
        if getattr(self, "all_wallpaper_paths", []):
            import random
            self.wallpaper_source.set_filename(str(random.choice(self.all_wallpaper_paths)))
            self.refresh_wallpaper_preview()

    def refresh_wallpaper_preview(self):
        source = self.wallpaper_source.get_filename()
        if not source:
            current = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "noir-rice/current-wallpaper"
            try:
                source = current.read_text().strip()
            except OSError:
                source = ""
        if source and Path(source).exists():
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(source, 900, 250, True)
                self.wallpaper_preview.set_from_pixbuf(pixbuf)
                return
            except Exception:
                pass
        self.wallpaper_preview.clear()

    def waybar_field(self, label, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        row.set_margin_top(5); row.set_margin_bottom(5)
        text = Gtk.Label(label=label, xalign=0)
        text.set_size_request(190, -1)
        text.get_style_context().add_class("card-copy")
        row.pack_start(text, False, False, 0)
        row.pack_start(widget, True, True, 0)
        return row

    def waybar_config(self):
        try:
            return json.loads(WAYBAR.joinpath("config.jsonc").read_text())
        except (OSError, ValueError):
            return {}

    def kitty_style(self):
        try:
            return KITTY_CONFIG.read_text()
        except OSError:
            return ""

    def kitty_value(self, text, key, fallback):
        match = re.search(rf"(?m)^{re.escape(key)}\s+([^\s]+)", text)
        return match.group(1) if match else fallback

    def terminal_page(self):
        text = self.kitty_style()
        box = self.page_box()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="LIVE KITTY CONFIGURATION", xalign=0); title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="Terminal changes save to Kitty and reload live when supported.", xalign=0); copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)
        self.kitty_font_size = Gtk.SpinButton.new_with_range(8, 32, 0.5)
        self.kitty_font_size.set_value(float(self.kitty_value(text, "font_size", "10.5")))
        self.kitty_padding = Gtk.SpinButton.new_with_range(0, 64, 1)
        self.kitty_padding.set_value(float(self.kitty_value(text, "window_padding_width", "0")))
        self.kitty_background_widget, self.kitty_background = self.color_control(self.kitty_value(text, "background", "#000000"))
        self.kitty_foreground_widget, self.kitty_foreground = self.color_control(self.kitty_value(text, "foreground", "#d0d0d0"))
        self.kitty_selection_widget, self.kitty_selection = self.color_control(self.kitty_value(text, "selection_background", "#2a2a2a"))
        for label, widget in (("Font size", self.kitty_font_size), ("Window padding", self.kitty_padding),
                              ("Background", self.kitty_background_widget), ("Foreground", self.kitty_foreground_widget),
                              ("Selection background", self.kitty_selection_widget)):
            card.pack_start(self.waybar_field(label, widget), False, False, 0)
        self.kitty_preview = Gtk.DrawingArea(); self.kitty_preview.set_size_request(-1, 130)
        self.kitty_preview.connect("draw", self.draw_kitty_preview)
        box.pack_start(card, False, False, 0)
        preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        preview_card.set_margin_start(16); preview_card.set_margin_end(16); preview_card.set_margin_bottom(14)
        preview_card.get_style_context().add_class("card")
        preview_card.get_style_context().add_class("preview-card")
        preview_title = Gtk.Label(label="TERMINAL PREVIEW", xalign=0); preview_title.get_style_context().add_class("card-title")
        preview_card.pack_start(preview_title, False, False, 0)
        preview_card.pack_start(self.kitty_preview, False, False, 0)
        box.pack_start(preview_card, False, False, 0)
        for widget in (self.kitty_font_size, self.kitty_padding):
            widget.connect("value-changed", lambda *_: self.schedule_live("kitty", self.apply_kitty, 450))
            widget.connect("value-changed", lambda *_: self.kitty_preview.queue_draw())
        for widget in (self.kitty_background, self.kitty_foreground, self.kitty_selection):
            widget.connect("changed", lambda *_: self.schedule_live("kitty", self.apply_kitty, 700))
            widget.connect("changed", lambda *_: self.kitty_preview.queue_draw())
        return box

    def draw_kitty_preview(self, _area, context):
        allocation = self.kitty_preview.get_allocation()
        width, height = allocation.width, allocation.height
        bg = self.preview_color(self.kitty_background, "000000")
        fg = self.preview_color(self.kitty_foreground, "d0d0d0")
        selection = self.preview_color(self.kitty_selection, "2a2a2a")
        context.set_source_rgba(*bg); context.paint()
        context.set_source_rgba(*selection); context.rectangle(12, 12, width * 0.72, 26); context.fill()
        context.set_source_rgba(*fg); context.set_font_size(max(10, self.kitty_font_size.get_value()))
        context.select_font_face("JetBrains Mono")
        context.move_to(22, 30); context.show_text("noir@desktop  ~  $ nvim")
        context.move_to(22, 68); context.show_text("terminal colors and spacing preview")
        context.move_to(22, 104); context.show_text("▌")
        return False

    def apply_kitty(self):
        try:
            text = self.kitty_style()
            colors = (self.kitty_background, self.kitty_foreground, self.kitty_selection)
            for field in colors:
                if not re.fullmatch(r"#[0-9a-fA-F]{6}", field.get_text().strip()):
                    raise ValueError("Kitty colors must be six-digit hex values")
            replacements = {
                r"(?m)^font_size\s+\S+": f"font_size {self.kitty_font_size.get_value():g}",
                r"(?m)^window_padding_width\s+\S+": f"window_padding_width {int(self.kitty_padding.get_value())}",
                r"(?m)^background\s+#[0-9a-fA-F]{6}": f"background {self.kitty_background.get_text().strip()}",
                r"(?m)^foreground\s+#[0-9a-fA-F]{6}": f"foreground {self.kitty_foreground.get_text().strip()}",
                r"(?m)^selection_background\s+#[0-9a-fA-F]{6}": f"selection_background {self.kitty_selection.get_text().strip()}",
            }
            for pattern, replacement in replacements.items():
                text = re.sub(pattern, replacement, text, count=1)
            KITTY_CONFIG.parent.mkdir(parents=True, exist_ok=True); KITTY_CONFIG.write_text(text)
            result = subprocess.run(["kitty", "@", "load-config"], capture_output=True, text=True)
            self.set_status("Kitty configuration saved and reloaded" if result.returncode == 0 else "Kitty configuration saved; reload existing terminals with Ctrl+Shift+F5")
        except Exception as error:
            self.set_status(f"Kitty error: {error}")

    def editor_page(self):
        state = {}
        try:
            state = json.loads(NVIM_STATE.read_text())
        except (OSError, json.JSONDecodeError):
            pass
        box = self.page_box()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="NOIR NEOVIM THEME", xalign=0); title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="These values are shared with the LazyVim Noir colorscheme and apply to new Neovim sessions.", xalign=0)
        copy.set_line_wrap(True); copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)
        self.nvim_background_widget, self.nvim_background = self.color_control(state.get("background", "#000000"))
        self.nvim_accent_widget, self.nvim_accent = self.color_control(state.get("accent", "#cfcfcf"))
        self.nvim_comment_widget, self.nvim_comment = self.color_control(state.get("comment", "#66666e"))
        self.nvim_transparent = Gtk.CheckButton(label="Transparent editor background")
        self.nvim_transparent.set_active(bool(state.get("transparent", False)))
        self.nvim_cursorline = Gtk.CheckButton(label="Highlight cursor line")
        self.nvim_cursorline.set_active(state.get("cursorline", True))
        self.nvim_numbers = Gtk.CheckButton(label="Show relative line numbers")
        self.nvim_numbers.set_active(state.get("relative_numbers", False))
        for label, widget in (("Editor background", self.nvim_background_widget), ("Accent", self.nvim_accent_widget),
                              ("Comments", self.nvim_comment_widget)):
            card.pack_start(self.waybar_field(label, widget), False, False, 0)
        for widget in (self.nvim_transparent, self.nvim_cursorline, self.nvim_numbers):
            card.pack_start(widget, False, False, 4)
        apply_button = Gtk.Button(label="Save Neovim theme")
        apply_button.get_style_context().add_class("action"); apply_button.connect("clicked", self.apply_editor)
        card.pack_start(apply_button, False, False, 6)
        box.pack_start(card, False, False, 0)
        for widget in (self.nvim_background, self.nvim_accent, self.nvim_comment):
            widget.connect("changed", lambda *_: self.schedule_live("nvim", self.apply_editor, 700))
        for widget in (self.nvim_transparent, self.nvim_cursorline, self.nvim_numbers):
            widget.connect("toggled", lambda *_: self.schedule_live("nvim", self.apply_editor, 300))
        return box

    def apply_editor(self, *_):
        colors = (self.nvim_background, self.nvim_accent, self.nvim_comment)
        if any(not re.fullmatch(r"#[0-9a-fA-F]{6}", field.get_text().strip()) for field in colors):
            self.set_status("Neovim colors must be six-digit hex values")
            return
        try:
            NVIM_STATE.parent.mkdir(parents=True, exist_ok=True)
            NVIM_STATE.write_text(json.dumps({
                "background": self.nvim_background.get_text().strip(),
                "accent": self.nvim_accent.get_text().strip(),
                "comment": self.nvim_comment.get_text().strip(),
                "transparent": self.nvim_transparent.get_active(),
                "cursorline": self.nvim_cursorline.get_active(),
                "relative_numbers": self.nvim_numbers.get_active(),
            }, indent=2) + "\n")
            self.set_status("Neovim theme saved; restart Neovim to apply")
        except OSError as error:
            self.set_status(f"Neovim theme error: {error}")

    def waybar_style(self):
        try:
            return WAYBAR.joinpath("style.css").read_text()
        except OSError:
            return ""

    def entry(self, value, width=300):
        field = Gtk.Entry()
        field.set_text(str(value))
        field.set_width_chars(max(12, width // 9))
        return field

    def color_control(self, value, allow_alpha=False):
        """Return a hex entry plus a native GTK color picker/swatch."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        field = self.entry(value, 120)
        picker = Gtk.ColorButton()
        picker.set_property("use-alpha", allow_alpha)
        picker.set_tooltip_text("Choose a color")

        def sync_picker(*_):
            raw = field.get_text().strip().lstrip("#")
            if len(raw) not in (6, 8) or any(char not in "0123456789abcdefABCDEF" for char in raw):
                return
            rgba = Gdk.RGBA()
            if rgba.parse("#" + raw):
                picker.set_rgba(rgba)

        def sync_entry(*_):
            rgba = picker.get_rgba()
            channels = tuple(max(0, min(255, round(channel * 255)))
                              for channel in (rgba.red, rgba.green, rgba.blue))
            text = "#%02x%02x%02x" % channels
            if allow_alpha:
                text += "%02x" % max(0, min(255, round(rgba.alpha * 255)))
            field.set_text(text)

        field.connect("changed", sync_picker)
        picker.connect("color-set", sync_entry)
        sync_picker()
        row.pack_start(field, True, True, 0)
        row.pack_start(picker, False, False, 0)
        return row, field

    def css_rgba(self, hex_color, opacity):
        raw = hex_color.lstrip("#")
        red, green, blue = (int(raw[index:index + 2], 16) for index in (0, 2, 4))
        return f"rgba({red}, {green}, {blue}, {opacity:.2f})"

    def waybar_page(self):
        config = self.waybar_config()
        clock = config.get("clock", {})
        center = config.get("modules-center", [])
        right = config.get("modules-right", [])
        style = self.waybar_style()
        match = re.search(r"window#waybar\s*\{([^}]*)\}", style, re.S)
        block = match.group(1) if match else ""
        font_match = re.search(r"font-size:\s*(\d+)px", style)
        bg_match = re.search(r"background:\s*(#[0-9a-fA-F]{6}|rgba\([^)]*\))", block)
        text_match = re.search(r"color:\s*(#[0-9a-fA-F]{6})", block)
        highlight_match = re.search(r"#workspaces button\.focused[^\{]*\{[^}]*background:\s*(#[0-9a-fA-F]{6})", style, re.S)
        surface_match = re.search(r"#workspaces button:hover\s*\{[^}]*background:\s*(#[0-9a-fA-F]{6})", style, re.S)
        opacity = 100
        background = bg_match.group(1) if bg_match else "#000000"
        if background.startswith("rgba"):
            parts = re.search(r"rgba\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*([0-9.]+)", background)
            opacity = round(float(parts.group(1)) * 100) if parts else 100
            rgb = re.search(r"rgba\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)", background)
            background = "#%02x%02x%02x" % tuple(int(value) for value in rgb.groups()) if rgb else "#000000"

        box = self.page_box()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="LIVE WAYBAR CONFIGURATION", xalign=0)
        title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="Changes preview live in the active Noir Waybar after a short pause.", xalign=0)
        copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)

        self.wb_height = Gtk.SpinButton.new_with_range(24, 64, 1)
        self.wb_height.set_value(config.get("height", 32))
        self.wb_spacing = Gtk.SpinButton.new_with_range(0, 24, 1)
        self.wb_spacing.set_value(config.get("spacing", 8))
        self.wb_font_size = Gtk.SpinButton.new_with_range(8, 20, 1)
        self.wb_font_size.set_value(int(font_match.group(1)) if font_match else 11)
        self.wb_clock = self.entry(clock.get("format", "{:%H:%M %a, %b %d}"), 360)
        self.wb_weather = self.entry(os.environ.get("NOIR_WEATHER_LOCATION", "Colombo"), 220)
        for label, widget in (("Bar height", self.wb_height), ("Module spacing", self.wb_spacing),
                              ("Font size", self.wb_font_size), ("Clock format", self.wb_clock),
                              ("Weather location", self.wb_weather)):
            card.pack_start(self.waybar_field(label, widget), False, False, 0)
        box.pack_start(card, False, False, 0)

        theme_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        theme_card.set_margin_top(0); theme_card.set_margin_bottom(14); theme_card.set_margin_start(16); theme_card.set_margin_end(16)
        theme_card.get_style_context().add_class("card")
        theme_title = Gtk.Label(label="LIVE THEME VARIABLES", xalign=0); theme_title.get_style_context().add_class("card-title")
        theme_copy = Gtk.Label(label="Adjust colors, opacity, and compositor blur with native color previews.", xalign=0); theme_copy.get_style_context().add_class("card-copy")
        theme_card.pack_start(theme_title, False, False, 0); theme_card.pack_start(theme_copy, False, False, 0)
        self.wb_background_widget, self.wb_background = self.color_control(background)
        self.wb_text_widget, self.wb_text = self.color_control(text_match.group(1) if text_match else "#f3f3f5")
        self.wb_highlight_widget, self.wb_highlight = self.color_control(highlight_match.group(1) if highlight_match else "#222226")
        self.wb_surface_widget, self.wb_surface = self.color_control(surface_match.group(1) if surface_match else "#18181c")
        theme_defaults = {
            "border": "#222226", "workspace_inactive": "#66666e", "workspace_active": "#ffffff",
            "workspace_hover": "#ffffff", "active_border": "#3a3a42", "layout": "#777780",
            "clock": "#f3f3f5", "weather": "#c2c2c8", "notifications": "#9999a1",
            "controls": "#a9a9b1", "resources": "#8f8f98", "power": "#eeeeee",
            "settings": "#bdbdbd", "settings_hover": "#ffffff", "hover_surface": "#1a1a1a",
            "warning": "#cfcfcf", "critical": "#ffffff",
        }
        self.wb_theme = {}
        theme_labels = {
            "border": "Bar border", "workspace_inactive": "Workspace inactive", "workspace_active": "Workspace active",
            "workspace_hover": "Workspace hover", "active_border": "Active border", "layout": "Layout icon",
            "clock": "Clock", "weather": "Weather", "notifications": "Notifications", "controls": "Audio / network",
            "resources": "CPU / memory", "power": "Power icon", "settings": "Settings icon", "settings_hover": "Settings hover",
            "hover_surface": "Hover surface", "warning": "Warning", "critical": "Critical",
        }
        theme_patterns = {
            "border": r"window#waybar\s*\{[^}]*border:\s*(#[0-9a-fA-F]{6})",
            "workspace_inactive": r"#workspaces button\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "workspace_active": r"#workspaces button\.focused[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "workspace_hover": r"#workspaces button:hover\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "active_border": r"#workspaces button\.focused[^}]*border-color:\s*(#[0-9a-fA-F]{6})",
            "layout": r"#custom-layout\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "clock": r"#clock\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "weather": r"#custom-weather\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "notifications": r"#custom-notifications\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "controls": r"#pulseaudio, #pulseaudio\\#microphone, #network, #battery\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "resources": r"#cpu, #memory, #disk\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "power": r"#custom-power\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "settings": r"#custom-settings\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "settings_hover": r"#custom-settings:hover\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "hover_surface": r"#custom-settings:hover\s*\{[^}]*background:\s*(#[0-9a-fA-F]{6})",
            "warning": r"#battery\.warning\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
            "critical": r"#battery\.critical\s*\{[^}]*color:\s*(#[0-9a-fA-F]{6})",
        }
        for key, pattern in theme_patterns.items():
            found = re.search(pattern, style, re.S)
            if found:
                theme_defaults[key] = found.group(1)
        for key, default in theme_defaults.items():
            widget, field = self.color_control(default)
            self.wb_theme[key] = field
            theme_card.pack_start(self.waybar_field(theme_labels[key], widget), False, False, 0)
        self.wb_opacity = Gtk.SpinButton.new_with_range(10, 100, 1); self.wb_opacity.set_value(opacity)
        self.wb_blur = Gtk.CheckButton(label="Enable compositor blur")
        blur_match = re.search(r"background-effect\s*\{[^}]*\bblur\s+(true|false)", Path(NIRI_CONFIG).read_text() if NIRI_CONFIG.exists() else "", re.S)
        self.wb_blur.set_active(bool(blur_match and blur_match.group(1) == "true"))
        for label, widget in (("Bar background", self.wb_background_widget), ("Bar text", self.wb_text_widget),
                              ("Highlight", self.wb_highlight_widget), ("Surface", self.wb_surface_widget),
                              ("Background opacity", self.wb_opacity)):
            theme_card.pack_start(self.waybar_field(label, widget), False, False, 0)
        theme_card.pack_start(self.wb_blur, False, False, 6)
        self.waybar_preview = Gtk.DrawingArea(); self.waybar_preview.set_size_request(-1, 86)
        self.waybar_preview.connect("draw", self.draw_waybar_preview)
        box.pack_start(theme_card, False, False, 0)
        preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        preview_card.set_margin_start(16); preview_card.set_margin_end(16); preview_card.set_margin_bottom(14)
        preview_card.get_style_context().add_class("card")
        preview_card.get_style_context().add_class("preview-card")
        preview_title = Gtk.Label(label="WAYBAR PREVIEW", xalign=0); preview_title.get_style_context().add_class("card-title")
        preview_card.pack_start(preview_title, False, False, 0)
        preview_card.pack_start(self.waybar_preview, False, False, 0)
        box.pack_start(preview_card, False, False, 0)

        modules = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        modules.set_margin_start(16); modules.set_margin_end(16)
        self.wb_workspaces = Gtk.CheckButton(label="Workspaces")
        self.wb_workspaces.set_active("niri/workspaces" in config.get("modules-left", []))
        self.wb_weather_toggle = Gtk.CheckButton(label="Weather")
        self.wb_weather_toggle.set_active("custom/weather" in center)
        self.wb_notifications = Gtk.CheckButton(label="Notifications")
        self.wb_notifications.set_active("custom/notifications" in center)
        self.wb_tray = Gtk.CheckButton(label="System tray")
        self.wb_tray.set_active("tray" in right)
        self.wb_cpu = Gtk.CheckButton(label="CPU")
        self.wb_cpu.set_active("cpu" in right)
        self.wb_memory = Gtk.CheckButton(label="RAM")
        self.wb_memory.set_active("memory" in right)
        self.wb_disk = Gtk.CheckButton(label="Disk")
        self.wb_disk.set_active("disk" in right)
        for button in (self.wb_workspaces, self.wb_weather_toggle, self.wb_notifications, self.wb_tray, self.wb_cpu, self.wb_memory, self.wb_disk):
            modules.pack_start(button, False, False, 0)
        box.pack_start(modules, False, False, 5)

        # Every Waybar field is a live preview.  Entry edits are debounced;
        # toggles and numeric controls feel immediate without thrashing Waybar.
        for widget in (self.wb_height, self.wb_spacing, self.wb_font_size):
            widget.connect("value-changed", lambda *_: self.schedule_live("waybar", self.apply_waybar, 500))
        for widget in (self.wb_clock, self.wb_weather, self.wb_background, self.wb_text, self.wb_highlight, self.wb_surface, *self.wb_theme.values()):
            widget.connect("changed", lambda *_: self.schedule_live("waybar", self.apply_waybar, 700))
            widget.connect("changed", lambda *_: self.waybar_preview.queue_draw())
        self.wb_opacity.connect("value-changed", lambda *_: self.schedule_live("waybar", self.apply_waybar, 450))
        self.wb_blur.connect("toggled", lambda *_: self.schedule_live("waybar", self.apply_waybar, 300))
        self.wb_opacity.connect("value-changed", lambda *_: self.waybar_preview.queue_draw())
        self.wb_blur.connect("toggled", lambda *_: self.waybar_preview.queue_draw())
        for widget in (self.wb_workspaces, self.wb_weather_toggle, self.wb_notifications,
                       self.wb_tray, self.wb_cpu, self.wb_memory, self.wb_disk):
            widget.connect("toggled", lambda *_: self.schedule_live("waybar", self.apply_waybar, 250))

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.set_margin_start(16)
        apply_button = Gtk.Button(label="Apply Waybar changes")
        apply_button.get_style_context().add_class("action")
        apply_button.connect("clicked", self.apply_waybar)
        actions.pack_start(apply_button, False, False, 0)
        box.pack_start(actions, False, False, 0)
        return box

    def rounded_rect(self, context, x, y, width, height, radius):
        context.new_sub_path()
        context.arc(x + width - radius, y + radius, radius, -1.5708, 0)
        context.arc(x + width - radius, y + height - radius, radius, 0, 1.5708)
        context.arc(x + radius, y + height - radius, radius, 1.5708, 3.1416)
        context.arc(x + radius, y + radius, radius, 3.1416, 4.7124)
        context.close_path()

    def draw_waybar_preview(self, _area, context):
        allocation = self.waybar_preview.get_allocation()
        width, height = allocation.width, allocation.height
        context.set_source_rgb(0, 0, 0); context.paint()
        background = self.preview_color(self.wb_background, "000000")
        text = self.preview_color(self.wb_text, "f3f3f5")
        highlight = self.preview_color(self.wb_highlight, "222226")
        border = self.preview_color(self.wb_theme["border"], "222226")
        opacity = float(self.wb_opacity.get_value()) / 100
        bar_height = min(42, max(20, float(self.wb_height.get_value())))
        x, y, w = 10, (height - bar_height) / 2, width - 20
        self.rounded_rect(context, x, y, w, bar_height, 5)
        context.set_source_rgba(background[0], background[1], background[2], opacity); context.fill_preserve()
        context.set_line_width(1); context.set_source_rgba(*border); context.stroke()
        context.set_source_rgba(*highlight)
        for index in range(5):
            px = x + 8 + index * 24
            self.rounded_rect(context, px, y + 6, 20, bar_height - 12, 4); context.fill()
        context.set_source_rgba(*text); context.set_font_size(10)
        context.move_to(x + 140, y + bar_height / 2 + 4); context.show_text("12:45  Weather  CPU  RAM  Audio  Network")
        return False

    def apply_waybar(self, *_):
        try:
            config = self.waybar_config()
            config["height"] = int(self.wb_height.get_value())
            config["spacing"] = int(self.wb_spacing.get_value())
            config.setdefault("clock", {})["format"] = self.wb_clock.get_text()
            weather_location = self.wb_weather.get_text().strip() or "Colombo"
            config.setdefault("custom/weather", {})["exec"] = (
                f"NOIR_WEATHER_LOCATION={shlex.quote(weather_location)} noir-weather"
            )
            left = [item for item in config.get("modules-left", []) if item != "niri/workspaces"]
            if self.wb_workspaces.get_active(): left.insert(0, "niri/workspaces")
            config["modules-left"] = left
            center = [item for item in config.get("modules-center", []) if item not in ("custom/weather", "custom/notifications")]
            if self.wb_weather_toggle.get_active(): center.insert(1 if center else 0, "custom/weather")
            if self.wb_notifications.get_active(): center.append("custom/notifications")
            config["modules-center"] = center
            right = [item for item in config.get("modules-right", []) if item not in ("tray", "cpu", "memory", "disk")]
            if self.wb_tray.get_active(): right.insert(0, "tray")
            if self.wb_cpu.get_active(): right.append("cpu")
            if self.wb_memory.get_active(): right.append("memory")
            if self.wb_disk.get_active(): right.append("disk")
            config["modules-right"] = right
            WAYBAR.joinpath("config.jsonc").write_text(json.dumps(config, indent=4) + "\n")

            css = self.waybar_style()
            css = re.sub(r"(\*\s*\{.*?font-size:\s*)\d+px", rf"\g<1>{int(self.wb_font_size.get_value())}px", css, count=1, flags=re.S)
            colors = {
                "background": self.wb_background.get_text().strip(),
                "text": self.wb_text.get_text().strip(),
                "highlight": self.wb_highlight.get_text().strip(),
                "surface": self.wb_surface.get_text().strip(),
            }
            palette = {key: field.get_text().strip() for key, field in self.wb_theme.items()}
            for name, value in colors.items():
                if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
                    raise ValueError(f"{name.title()} must be a six-digit color such as #000000")
            for name, value in palette.items():
                if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
                    raise ValueError(f"{name.replace('_', ' ').title()} must be a six-digit color")
            opacity = int(self.wb_opacity.get_value()) / 100
            bg = self.css_rgba(colors["background"], opacity)
            css = re.sub(r"(window#waybar\s*\{[^}]*?background:\s*)(?:#[0-9a-fA-F]{6}|rgba\([^)]*\))",
                         rf"\g<1>{bg}", css, count=1, flags=re.S)
            css = re.sub(r"(window#waybar\s*\{[^}]*?border:\s*)#[0-9a-fA-F]{6}",
                         rf"\g<1>{palette['border']}", css, count=1, flags=re.S)
            css = re.sub(r"(window#waybar\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}",
                         rf"\g<1>{colors['text']}", css, count=1, flags=re.S)
            css = re.sub(r"(#workspaces button\.focused[^\{]*\{[^}]*?background:\s*)#[0-9a-fA-F]{6}",
                         rf"\g<1>{colors['highlight']}", css, count=1, flags=re.S)
            css = re.sub(r"(#workspaces button:hover\s*\{[^}]*?background:\s*)#[0-9a-fA-F]{6}",
                         rf"\g<1>{palette['hover_surface']}", css, count=1, flags=re.S)
            replacements = {
                r"(#workspaces button\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["workspace_inactive"],
                r"(#workspaces button\.focused[^\{]*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["workspace_active"],
                r"(#workspaces button\.focused[^\{]*\{[^}]*?border-color:\s*)#[0-9a-fA-F]{6}": palette["active_border"],
                r"(#workspaces button:hover\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["workspace_hover"],
                r"(#custom-layout\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["layout"],
                r"(#clock\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["clock"],
                r"(#custom-weather\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["weather"],
                r"(#custom-notifications\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["notifications"],
                r"(#pulseaudio, #pulseaudio\\#microphone, #network, #battery\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["controls"],
                r"(#cpu, #memory, #disk\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["resources"],
                r"(#custom-power\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["power"],
                r"(#custom-settings\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["settings"],
                r"(#custom-settings:hover\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["settings_hover"],
                r"(#custom-settings:hover\s*\{[^}]*?background:\s*)#[0-9a-fA-F]{6}": palette["hover_surface"],
                r"(#battery\.warning\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["warning"],
                r"(#battery\.critical\s*\{[^}]*?color:\s*)#[0-9a-fA-F]{6}": palette["critical"],
            }
            for pattern, value in replacements.items():
                css = re.sub(pattern, rf"\g<1>{value}", css, count=1, flags=re.S)
            WAYBAR.joinpath("style.css").write_text(css)
            niri_text = NIRI_CONFIG.read_text()
            blur = "true" if self.wb_blur.get_active() else "false"
            niri_text = re.sub(r"(background-effect\s*\{[^}]*\bblur\s+)\w+",
                               rf"\g<1>{blur}", niri_text, count=1, flags=re.S)
            NIRI_CONFIG.write_text(niri_text)
            self.reload_waybar()
            self.launch(["niri", "msg", "action", "load-config-file"], "Waybar theme and blur applied live")
        except Exception as error:
            self.set_status(f"Waybar error: {error}")

    def reload_waybar(self):
        subprocess.run(["pkill", "-x", "waybar"], stderr=subprocess.DEVNULL)
        self.launch(["waybar"], "Waybar reloaded")

    def toggle_waybar(self):
        if subprocess.run(["pgrep", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["pkill", "-x", "waybar"])
            self.set_status("Waybar hidden")
        else:
            self.launch(["waybar"], "Waybar shown")

    def display_page(self):
        box = self.page_box()
        box.pack_start(self.card("DISPLAY PROFILES", "Open the Noir display selector to apply primary-only, secondary-only, mirrored, or extended layouts.", [
            ("Open display menu", lambda *_: self.launch(self.local("noir-display-menu"), "Display menu opened"), True),
            ("Fine-tune displays", lambda *_: self.launch(["nwg-displays"], "Detailed display settings opened"), False),
        ]), False, False, 0)
        box.pack_start(self.card("CURRENT COMPOSITOR", "Display changes are applied through Niri IPC and take effect immediately.", [
            ("Reload Niri config", lambda *_: self.launch(["niri", "msg", "action", "load-config-file"], "Niri configuration reloaded"), False),
        ]), False, False, 0)
        return box

