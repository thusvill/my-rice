        ]), False, False, 0)
        return box

    def diagnostics_page(self):
        box = self.page_box()
        box.pack_start(self.card("NOIR HEALTH CHECK", "Check required commands, configuration syntax, and the active session.", [
            ("Run diagnostics", lambda *_: self.run_diagnostics(), True),
            ("Create backup", lambda *_: self.create_backup(), False),
            ("Open backups", lambda *_: self.launch(["kitty", "--directory", str(HOME / ".local/state/noir-rice/backups")], "Backup directory opened"), False),
        ]), False, False, 0)
        self.diagnostic_output = Gtk.Label(label="Press Run diagnostics to check the rice.", xalign=0)
        self.diagnostic_output.set_selectable(True); self.diagnostic_output.set_line_wrap(True)
        self.diagnostic_output.get_style_context().add_class("status")
        box.pack_start(self.diagnostic_output, False, False, 16)
        return box

    def create_backup(self):
        try:
            result = subprocess.run(self.local("noir-backup"), capture_output=True, text=True, check=True)
            self.set_status(result.stdout.strip() or "Manual backup created")
        except (OSError, subprocess.CalledProcessError) as error:
            self.set_status(f"Backup error: {error}")

    def run_diagnostics(self):
        required = ("niri", "ags", "gjs", "kitty", "swaylock", "swaybg", "fuzzel", "jq")
        optional = ("magick", "wl-mirror", "nwg-displays", "fc-match")
        lines = ["NOIR DIAGNOSTICS"]
        for command in required:
            lines.append(f"{'OK  ' if shutil.which(command) else 'MISS'} required: {command}")
        for command in optional:
            lines.append(f"{'OK  ' if shutil.which(command) else '----'} optional: {command}")
        checks = (("Astal shell", [str(BIN / "noir-astal-check")]),
                  ("Astal project", ["test", "-f", str(ASTAL / "app.tsx")]),
                  ("Niri KDL", ["niri", "validate", "-c", str(NIRI_CONFIG)]),
                  ("Settings Python", ["python3", "-m", "py_compile", str(BIN / "noir-settings")]))
        for label, command in checks:
            try:
                result = subprocess.run(command, capture_output=True, text=True)
                lines.append(f"{'OK  ' if result.returncode == 0 else 'FAIL'} {label}")
            except OSError:
                lines.append(f"FAIL {label}: command unavailable")
        lines.append(f"Backups: {HOME / '.local/state/noir-rice/backups'}")
        self.diagnostic_output.set_text("\n".join(lines))
        self.set_status("Diagnostics completed")

