    def save_astal_settings(self, *_):
        self.astal_settings_saved = False
        colors = {key: field.get_text().strip() or fallback for (key, fallback), field
                  in zip((("background", "#000000"), ("surface", "#121215"),
                          ("foreground", "#f3f3f5"), ("muted", "#9999a1"),
                          ("border", "#29292f"), ("accent", "#cfcfcf")),
                         self.astal_colors.values())}
        if any(not re.fullmatch(r"#[0-9a-fA-F]{6}", color) for color in colors.values()):
            self.set_status("Astal colors must use #RRGGBB format")
            return
        values = {
            "height": int(self.astal_height.get_value()), "spacing": int(self.astal_spacing.get_value()),
            "font_size": int(self.astal_font_size.get_value()), "padding": int(self.astal_padding.get_value()),
            "radius": int(self.astal_radius.get_value()), "opacity": int(self.astal_opacity.get_value()),
            "clock_format": self.astal_clock.get_text().strip() or "%H:%M %a, %b %d",
            "weather_location": self.astal_weather.get_text().strip() or "Colombo",
            "visible_modules": [key for key, toggle in self.astal_modules.items() if toggle.get_active()],
        }
        values.update(colors)
        try:
            ASTAL_STATE.parent.mkdir(parents=True, exist_ok=True)
            ASTAL_STATE.write_text(json.dumps(values, indent=2) + "\n")
            self.astal_settings_saved = True
            self.set_status("Astal preferences saved")
        except OSError as error:
            self.set_status(f"Astal settings error: {error}")

    def draw_astal_preview(self, _area, context):
        allocation = self.astal_preview.get_allocation()
        width, height = allocation.width, allocation.height
        context.set_source_rgb(0.035, 0.035, 0.04); context.paint()
        background = self.preview_color(self.astal_colors["background"], "000000")
        surface = self.preview_color(self.astal_colors["surface"], "121215")
        foreground = self.preview_color(self.astal_colors["foreground"], "f3f3f5")
        muted = self.preview_color(self.astal_colors["muted"], "9999a1")
        border = self.preview_color(self.astal_colors["border"], "29292f")
        accent = self.preview_color(self.astal_colors["accent"], "cfcfcf")
        bar_height = min(height - 20, max(10, self.astal_height.get_value()))
        x, y, bar_width = 10, (height - bar_height) / 2, width - 20
        self.rounded_rect(context, x, y, bar_width, bar_height, min(self.astal_radius.get_value(), bar_height / 2))
        context.set_source_rgba(background[0], background[1], background[2],
                                background[3] * self.astal_opacity.get_value() / 100)
        context.fill_preserve()
        context.set_source_rgba(*border); context.set_line_width(1); context.stroke()
        size = max(8, min(14, self.astal_font_size.get_value()))
        context.select_font_face("JetBrains Mono", 0, 0); context.set_font_size(size)
        gap = " " * max(1, round(self.astal_spacing.get_value() / 2))
        inset = self.astal_padding.get_value() + 4
        left, middle, right = [], [], []
        if self.astal_modules["workspaces"].get_active(): left.append("1   2   3")
        if self.astal_modules["settings"].get_active(): left.append("⚙")
        if self.astal_modules["clock"].get_active(): middle.append("12:45")
        if self.astal_modules["weather"].get_active(): middle.append("☁ 18°C")
        if self.astal_modules["notifications"].get_active(): middle.append("●")
        for key, label in (("cpu", "CPU 8%"), ("memory", "RAM 42%"), ("disk", "DISK 30%"),
                           ("volume", "VOL 35%"), ("mic", "MIC"), ("brightness", "☼"),
                           ("battery", "BAT 82%"), ("network", "Wi-Fi"), ("bluetooth", "BT"),
                           ("power", "⏻")):
            if self.astal_modules[key].get_active(): right.append(label)
        if self.astal_modules["workspaces"].get_active():
            context.set_source_rgba(*surface)
            chip_width = max(24, size * 2.1)
            self.rounded_rect(context, x + inset - 3, y + max(3, (bar_height - size - 8) / 2),
                              chip_width, min(bar_height - 6, size + 8), min(self.astal_radius.get_value(), 5))
            context.fill()
        context.set_source_rgba(*muted)
        context.move_to(x + inset, y + bar_height / 2 + size / 3); context.show_text(gap.join(left))
        center_text = gap.join(middle)
        extents = context.text_extents(center_text)
        context.set_source_rgba(*foreground)
        context.move_to(x + (bar_width - extents.width) / 2, y + bar_height / 2 + size / 3)
        context.show_text(center_text)
        right_text = gap.join(right)
        extents = context.text_extents(right_text)
        context.set_source_rgba(*accent)
        context.move_to(x + bar_width - extents.width - inset, y + bar_height / 2 + size / 3)
        context.show_text(right_text)
        return False

    def apply_astal_settings(self, *_):
        self.save_astal_settings()
        if self.astal_settings_saved:
            self.reload_astal()

    def reload_astal(self):
        subprocess.run(["ags", "quit"], stderr=subprocess.DEVNULL)
        self.launch(["ags", "run", str(ASTAL / "app.tsx")], "Astal shell reloaded")

    def apply_noir_preset(self):
        self.wb_height.set_value(32); self.wb_spacing.set_value(8); self.wb_font_size.set_value(11)
        self.wb_clock.set_text("{:%H:%M %a, %b %d}"); self.wb_background.set_text("#000000")
        self.wb_text.set_text("#f3f3f5"); self.wb_highlight.set_text("#222226"); self.wb_surface.set_text("#18181c")
        self.wb_opacity.set_value(100); self.wb_blur.set_active(False)
        self.wb_workspaces.set_active(True); self.wb_weather_toggle.set_active(True)
        self.wb_notifications.set_active(True); self.wb_tray.set_active(True)
        self.wb_cpu.set_active(True); self.wb_memory.set_active(True)
        self.wb_disk.set_active(True)
        self.niri_gaps.set_value(8); self.niri_ring.set_value(2)
        self.niri_center.set_active_id("never"); self.niri_default_width.set_value(0.5)
        self.niri_active.set_text("#cfcfcf"); self.niri_inactive.set_text("#242424")
        self.apply_waybar(); self.apply_niri()

    def reload_all(self):
        self.reload_astal()
        self.launch(["niri", "msg", "action", "load-config-file"], "Astal and Niri reloaded")


def main():
    window = NoirSettings()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
