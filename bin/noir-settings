    def regenerate_lock_preview(self):
        try:
            subprocess.Popen(self.local("noir-lockscreen", "--preview"), start_new_session=True)
            GLib.timeout_add(1000, lambda: (self.lock_preview.queue_draw() or False))
        except OSError:
            self.lock_preview.queue_draw()

    def preview_color(self, field, fallback):
        raw = field.get_text().strip().lstrip("#")
        if len(raw) not in (6, 8) or any(char not in "0123456789abcdefABCDEF" for char in raw):
            raw = fallback
        values = tuple(int(raw[index:index + 2], 16) / 255 for index in (0, 2, 4))
        alpha = int(raw[6:8], 16) / 255 if len(raw) == 8 else 1.0
        return (*values, alpha)

    def draw_lockscreen_preview(self, _area, context):
        allocation = self.lock_preview.get_allocation()
        width, height = allocation.width, allocation.height
        bg = self.preview_color(self.lock_background, "000000")
        inside = self.preview_color(self.lock_inside, "121215")
        ring = self.preview_color(self.lock_ring, "cfcfcf")
        text = self.preview_color(self.lock_text, "d0d0d0")
        background_image = HOME / ".cache/noir-rice/lockscreen-background.png"
        if background_image.exists():
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(background_image), width, height, True)
                Gdk.cairo_set_source_pixbuf(context, pixbuf, (width - pixbuf.get_width()) / 2,
                                            (height - pixbuf.get_height()) / 2)
                context.paint()
            except Exception:
                context.set_source_rgba(*bg); context.paint()
        else:
            context.set_source_rgba(*bg); context.paint()
        center_x, center_y = width / 2, height / 2
        radius = min(float(self.lock_radius.get_value()), min(width, height) * 0.28)
        thickness = max(1.0, float(self.lock_thickness.get_value()))
        context.arc(center_x, center_y, radius, 0, 6.283185307)
        context.set_source_rgba(*inside); context.fill_preserve()
        context.set_line_width(thickness)
        context.set_source_rgba(*ring); context.stroke()
        clock_color = self.preview_color(self.lock_clock_color, "d0d0d0")
        context.set_source_rgba(*clock_color)
        context.set_font_size(max(12.0, min(float(self.lock_clock_size.get_value()), 72.0)))
        context.select_font_face(self.lock_clock_font.get_text() or "JetBrains Mono")
        if not background_image.exists() and self.lock_clock.get_active():
            label = time.strftime(self.lock_clock_format.get_text() or "%H:%M")
            extents = context.text_extents(label)
            position = self.lock_clock_position.get_active_id() or "top"
            y = 42 if position == "top" else (center_y + extents.height / 2 if position == "center" else height - 42)
            context.move_to(center_x - extents.width / 2, y)
            context.show_text(label)
        context.set_source_rgba(*text)
        context.set_font_size(max(8.0, min(float(self.lock_size.get_value()), 32.0)))
        context.select_font_face(self.lock_font.get_text() or "JetBrains Mono")
        label = "Enter password"
        extents = context.text_extents(label)
        context.move_to(center_x - extents.width / 2, center_y + extents.height / 2)
        context.show_text(label)
        context.set_font_size(12)
        context.move_to(18, 24)
        context.show_text("NOIR LOCK SCREEN")
        if self.lock_failed.get_active():
            context.move_to(18, height - 18)
            context.show_text("Failed attempts: 0")
        return False

    def apply_lockscreen(self, *_):
        colors = (self.lock_background, self.lock_inside, self.lock_inside_clear, self.lock_inside_ver,
                  self.lock_inside_wrong, self.lock_ring, self.lock_ring_clear, self.lock_ring_ver,
                  self.lock_ring_wrong, self.lock_line, self.lock_key_hl, self.lock_bs_hl, self.lock_text)
        for field in colors:
            if not re.fullmatch(r"[0-9a-fA-F]{6,8}", field.get_text().strip().lstrip("#")):
                self.set_status("Lock screen colors must be rrggbb or rrggbbaa")
                return
        values = [
            "# Noir Swaylock configuration", f"color={self.lock_background.get_text().strip().lstrip('#')}",
            f"inside-color={self.lock_inside.get_text().strip().lstrip('#')}",
            f"inside-clear-color={self.lock_inside_clear.get_text().strip().lstrip('#')}",
            f"inside-ver-color={self.lock_inside_ver.get_text().strip().lstrip('#')}",
            f"inside-wrong-color={self.lock_inside_wrong.get_text().strip().lstrip('#')}",
            f"ring-color={self.lock_ring.get_text().strip().lstrip('#')}",
            f"ring-clear-color={self.lock_ring_clear.get_text().strip().lstrip('#')}",
            f"ring-ver-color={self.lock_ring_ver.get_text().strip().lstrip('#')}",
            f"ring-wrong-color={self.lock_ring_wrong.get_text().strip().lstrip('#')}",
            f"line-color={self.lock_line.get_text().strip().lstrip('#')}",
            f"key-hl-color={self.lock_key_hl.get_text().strip().lstrip('#')}",
            f"bs-hl-color={self.lock_bs_hl.get_text().strip().lstrip('#')}",
            f"text-color={self.lock_text.get_text().strip().lstrip('#')}",
            f"font={self.lock_font.get_text()}", f"font-size={int(self.lock_size.get_value())}",
            f"indicator-radius={int(self.lock_radius.get_value())}", f"indicator-thickness={int(self.lock_thickness.get_value())}",
            "show-failed-attempts" if self.lock_failed.get_active() else "",
        ]
        try:
            SWAYLOCK_CONFIG.parent.mkdir(parents=True, exist_ok=True)
            SWAYLOCK_CONFIG.write_text("\n".join(line for line in values if line) + "\n")
            LOCKSCREEN_STATE.parent.mkdir(parents=True, exist_ok=True)
            LOCKSCREEN_STATE.write_text(json.dumps({
                "wallpaper": self.lock_wallpaper.get_text().strip(),
                "blur": int(self.lock_blur.get_value()),
                "clock": self.lock_clock.get_active(),
                "clock_format": self.lock_clock_format.get_text() or "%H:%M",
                "clock_size": int(self.lock_clock_size.get_value()),
                "clock_color": self.lock_clock_color.get_text().strip(),
                "clock_font": self.lock_clock_font.get_text() or "JetBrains Mono",
                "clock_position": self.lock_clock_position.get_active_id() or "top",
                "clock_x": int(self.lock_clock_x.get_value()),
                "clock_y": int(self.lock_clock_y.get_value()),
            }, indent=2) + "\n")
            self.regenerate_lock_preview()
            self.set_status("Lock screen configuration applied")
        except OSError as error:
            self.set_status(f"Lock screen error: {error}")

    def niri_page(self):
        box = self.page_box()
        try:
            niri_text = NIRI_CONFIG.read_text()
        except OSError:
            niri_text = ""
        gap_match = re.search(r"\bgaps\s+(\d+)", niri_text)
        ring_match = re.search(r"focus-ring\s*\{.*?width\s+(\d+)", niri_text, re.S)
        active_match = re.search(r"focus-ring\s*\{.*?active-color\s+\"(#[0-9a-fA-F]{6})\"", niri_text, re.S)
        inactive_match = re.search(r"focus-ring\s*\{.*?inactive-color\s+\"(#[0-9a-fA-F]{6})\"", niri_text, re.S)
        center_match = re.search(r"center-focused-column\s+\"([^\"]+)\"", niri_text)
        default_width_match = re.search(r"default-column-width\s*\{\s*proportion\s+([0-9.]+)", niri_text, re.S)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.set_margin_top(14); card.set_margin_bottom(14); card.set_margin_start(16); card.set_margin_end(16)
        card.get_style_context().add_class("card")
        title = Gtk.Label(label="NIRI LAYOUT CONFIGURATION", xalign=0); title.get_style_context().add_class("card-title")
        copy = Gtk.Label(label="Layout and focus-ring changes reload live without opening the KDL configuration file.", xalign=0); copy.get_style_context().add_class("card-copy")
        card.pack_start(title, False, False, 0); card.pack_start(copy, False, False, 0)
        self.niri_gaps = Gtk.SpinButton.new_with_range(0, 48, 1); self.niri_gaps.set_value(int(gap_match.group(1)) if gap_match else 8)
        self.niri_ring = Gtk.SpinButton.new_with_range(0, 12, 1); self.niri_ring.set_value(int(ring_match.group(1)) if ring_match else 2)
        self.niri_active_widget, self.niri_active = self.color_control(active_match.group(1) if active_match else "#cfcfcf")
        self.niri_inactive_widget, self.niri_inactive = self.color_control(inactive_match.group(1) if inactive_match else "#242424")
        self.niri_center = Gtk.ComboBoxText()
        for value in ("never", "always", "on-overflow"):
            self.niri_center.append(value, value.replace("-", " ").title())
        self.niri_center.set_active_id(center_match.group(1) if center_match else "never")
        self.niri_default_width = Gtk.SpinButton.new_with_range(0.1, 1.0, 0.05)
        self.niri_default_width.set_value(float(default_width_match.group(1)) if default_width_match else 0.5)
        for label, widget in (("Window gaps", self.niri_gaps), ("Focus ring width", self.niri_ring),
                              ("Active ring color", self.niri_active_widget), ("Inactive ring color", self.niri_inactive_widget),
                              ("Center focused column", self.niri_center), ("Default column width", self.niri_default_width)):
            card.pack_start(self.waybar_field(label, widget), False, False, 0)
        self.niri_preview = Gtk.DrawingArea(); self.niri_preview.set_size_request(-1, 210)
        self.niri_preview.connect("draw", self.draw_niri_preview)
        preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        preview_card.set_margin_start(16); preview_card.set_margin_end(16); preview_card.set_margin_bottom(14)
        preview_card.get_style_context().add_class("card")
        preview_card.get_style_context().add_class("preview-card")
        preview_title = Gtk.Label(label="NIRI LAYOUT PREVIEW", xalign=0); preview_title.get_style_context().add_class("card-title")
        preview_card.pack_start(preview_title, False, False, 0)
        preview_card.pack_start(self.niri_preview, False, False, 0)
        self.niri_gaps.connect("value-changed", lambda *_: self.schedule_live("niri", self.apply_niri, 450))
        self.niri_ring.connect("value-changed", lambda *_: self.schedule_live("niri", self.apply_niri, 450))
        self.niri_active.connect("changed", lambda *_: self.schedule_live("niri", self.apply_niri, 700))
        self.niri_inactive.connect("changed", lambda *_: self.schedule_live("niri", self.apply_niri, 700))
        self.niri_center.connect("changed", lambda *_: self.schedule_live("niri", self.apply_niri, 350))
        self.niri_default_width.connect("value-changed", lambda *_: self.schedule_live("niri", self.apply_niri, 450))
        self.niri_gaps.connect("value-changed", lambda *_: self.niri_preview.queue_draw())
        self.niri_ring.connect("value-changed", lambda *_: self.niri_preview.queue_draw())
        self.niri_active.connect("changed", lambda *_: self.niri_preview.queue_draw())
        self.niri_inactive.connect("changed", lambda *_: self.niri_preview.queue_draw())
        self.niri_default_width.connect("value-changed", lambda *_: self.niri_preview.queue_draw())
        button = Gtk.Button(label="Apply Niri layout")
        button.get_style_context().add_class("action"); button.connect("clicked", self.apply_niri)
        card.pack_start(button, False, False, 8)
        box.pack_start(card, False, False, 0)
        box.pack_start(preview_card, False, False, 0)
        box.pack_start(self.card("WINDOW MANAGER ACTIONS", "Use the existing Noir keyboard-first Niri setup.", [
            ("Reload Niri config", lambda *_: self.launch(["niri", "msg", "action", "load-config-file"], "Niri configuration reloaded"), True),
        ]), False, False, 0)
        return box

    def draw_niri_preview(self, _area, context):
        allocation = self.niri_preview.get_allocation()
        width, height = allocation.width, allocation.height
        context.set_source_rgb(0, 0, 0); context.paint()
        active = self.preview_color(self.niri_active, "cfcfcf")
        inactive = self.preview_color(self.niri_inactive, "242424")
        gaps = float(self.niri_gaps.get_value())
        ring = max(0, float(self.niri_ring.get_value()))
        left = 18 + gaps; top = 24 + gaps
        column_width = (width - 36 - gaps * 4) / 3
        window_height = height - 48 - gaps * 2
        for index in range(3):
            x = left + index * (column_width + gaps)
            context.set_source_rgb(0.08, 0.08, 0.09)
            context.rectangle(x, top, column_width, window_height); context.fill()
            context.set_line_width(ring or 1)
            context.set_source_rgba(*(active if index == 1 else inactive))
            context.rectangle(x + ring / 2, top + ring / 2, column_width - ring, window_height - ring); context.stroke()
        context.set_source_rgba(*active); context.set_font_size(10)
        context.move_to(24, height - 12); context.show_text(f"gaps {int(gaps)}   focus ring {int(ring)}")
        return False

    def apply_niri(self, *_):
        try:
            text = NIRI_CONFIG.read_text()
            text = re.sub(r"(\bgaps\s+)\d+", rf"\g<1>{int(self.niri_gaps.get_value())}", text, count=1)
            text = re.sub(r"(focus-ring\s*\{.*?\bwidth\s+)\d+", rf"\g<1>{int(self.niri_ring.get_value())}", text, count=1, flags=re.S)
            center = self.niri_center.get_active_id() or "never"
            text = re.sub(r"(center-focused-column\s+\")[^\"]+(\")", rf"\g<1>{center}\g<2>", text, count=1)
            text = re.sub(r"(default-column-width\s*\{\s*proportion\s+)[0-9.]+",
                          rf"\g<1>{self.niri_default_width.get_value():.2f}", text, count=1, flags=re.S)
            for key, value in (("active-color", self.niri_active.get_text()), ("inactive-color", self.niri_inactive.get_text())):
                if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
                    raise ValueError(f"{key} must be a six-digit color")
                text = re.sub(rf'(focus-ring\s*\{{.*?\b{key}\s+\")[^\"]+(\")', rf'\g<1>{value}\g<2>', text, count=1, flags=re.S)
            NIRI_CONFIG.write_text(text)
            self.launch(["niri", "msg", "action", "load-config-file"], "Niri layout applied")
        except Exception as error:
            self.set_status(f"Niri error: {error}")

    def presets_page(self):
        box = self.page_box()
        box.pack_start(self.card("NOIR PRESETS", "Apply the monochrome defaults and reload the active desktop components.", [
            ("Apply Noir defaults", lambda *_: self.apply_noir_preset(), True),
