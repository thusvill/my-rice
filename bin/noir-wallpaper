#!/usr/bin/env bash
set -euo pipefail

user_home="${HOME}"
wallpaper_dir="${user_home}/Pictures/Wallpapers"
cache_dir="${XDG_CACHE_HOME:-${user_home}/.cache}/noir-rice"
current_file="$cache_dir/current-wallpaper"
source_file="$cache_dir/source-wallpaper"
pid_file="$cache_dir/swaybg.pid"
slideshow_pid_file="$cache_dir/slideshow.pid"
cycle_pid_file="$cache_dir/cycle.pid"
favorites_file="$cache_dir/favorites"
automation_state="${XDG_CONFIG_HOME:-${user_home}/.config}/noir-rice/wallpaper.json"
mkdir -p "$cache_dir"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send -t 2200 -a "Noir Wallpaper" "$1" "${2:-}"
}

wallpapers() {
    find "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print | sort -f
}

set_wallpaper() {
    local target="$1"
    local applied
    [[ -f "$target" ]] || return 1
    applied="$(wallpaper_pipeline "$target")" || return 1
    if [[ -f "$pid_file" ]]; then
        kill "$(cat "$pid_file")" 2>/dev/null || true
    fi
    swaybg -i "$applied" -m fill >/dev/null 2>&1 &
    echo "$!" > "$pid_file"
    printf '%s\n' "$applied" > "$current_file"
    printf '%s\n' "$target" > "$source_file"
    command -v noir-palette >/dev/null 2>&1 && noir-palette auto >/dev/null 2>&1 || true
    notify "Wallpaper updated" "$(basename -- "$target")$( [[ "$applied" != "$target" ]] && printf ' (dithered)' )"
}

random_wallpaper() {
    mapfile -t available < <(wallpapers)
    ((${#available[@]})) || return 1
    printf '%s\n' "${available[RANDOM % ${#available[@]}]}"
}

favorite_wallpaper() {
    local target="${1:-$(cat "$current_file" 2>/dev/null || true)}"
    [[ -f "$target" ]] || return 1
    touch "$favorites_file"
    grep -Fxq "$target" "$favorites_file" 2>/dev/null || printf '%s\n' "$target" >> "$favorites_file"
    notify "Wallpaper favorite saved" "$(basename -- "$target")"
}

slideshow() {
    local delay="${1:-300}"
    [[ "$delay" =~ ^[0-9]+$ ]] || delay=300
    printf '%s\n' "$$" > "$slideshow_pid_file"
    trap 'rm -f "$slideshow_pid_file"' EXIT INT TERM
    while true; do
        set_wallpaper "$(random_wallpaper)"
        sleep "$delay"
    done
}

cycle() {
    local delay="${1:-1800}"
    [[ "$delay" =~ ^[0-9]+$ ]] || delay=1800
    printf '%s\n' "$$" > "$cycle_pid_file"
    trap 'rm -f "$cycle_pid_file"' EXIT INT TERM
    while true; do
        set_wallpaper "$(random_wallpaper)"
        sleep "$delay"
    done
}

start_cycle() {
    local delay="${1:-1800}"
    stop_cycle
    cycle "$delay" >/dev/null 2>&1 &
    disown || true
}

stop_cycle() {
    if [[ -f "$cycle_pid_file" ]]; then
        kill "$(cat "$cycle_pid_file")" 2>/dev/null || true
        rm -f "$cycle_pid_file"
    fi
}

automation_value() {
    local key="$1"
    if [[ -f "$automation_state" ]] && command -v jq >/dev/null 2>&1; then
        if [[ "$key" == "interval_seconds" ]]; then
            jq -r ".${key} // 1800" "$automation_state" 2>/dev/null || printf '1800\n'
        else
            jq -r ".${key} // false" "$automation_state" 2>/dev/null || printf 'false\n'
        fi
    else
        printf 'false\n'
    fi
}

stop_slideshow() {
    if [[ -f "$slideshow_pid_file" ]]; then
        kill "$(cat "$slideshow_pid_file")" 2>/dev/null || true
        rm -f "$slideshow_pid_file"
    fi
}

wallpaper_setting() {
    local key="$1"
    local fallback="$2"
    if [[ -f "$automation_state" ]] && command -v jq >/dev/null 2>&1; then
        jq -r --arg fallback "$fallback" ".${key} // \$fallback" "$automation_state" 2>/dev/null || printf '%s\n' "$fallback"
    else
        printf '%s\n' "$fallback"
    fi
}

wallpaper_pipeline() {
    local source="$1"
    if [[ "$(wallpaper_setting dither_enabled false)" != "true" ]]; then
        printf '%s\n' "$source"
        return 0
    fi
    local output="$cache_dir/dithered-wallpaper.png"
    local converter=()
    local colors method pattern
    [[ -f "$source" ]] || return 1
    if command -v magick >/dev/null 2>&1; then
        converter=(magick)
    elif command -v convert >/dev/null 2>&1; then
        converter=(convert)
    else
        notify "Dithered wallpaper unavailable" "Install ImageMagick"
        return 1
    fi
    colors="$(wallpaper_setting dither_colors 16)"
    method="$(wallpaper_setting dither_method FloydSteinberg)"
    pattern="$(wallpaper_setting dither_pattern o8x8)"
    if ! [[ "$colors" =~ ^[0-9]+$ ]] || (( colors < 2 || colors > 256 )); then
        colors=16
    fi
    case "$method" in
        Ordered) "${converter[@]}" "$source" -colors "$colors" -ordered-dither "$pattern" "$output" ;;
        None) "${converter[@]}" "$source" -colors "$colors" -dither None "$output" ;;
        *) "${converter[@]}" "$source" -colors "$colors" -dither "$method" "$output" ;;
    esac
    printf '%s\n' "$output"
}

select_wallpaper() {
    local options='[ Random wallpaper ]'
    options+=$'\n'
    options+="$(wallpapers | sed "s#^$wallpaper_dir/##")"
    local chosen
    chosen="$(printf '%s\n' "$options" | fuzzel --dmenu --prompt 'Wallpaper ❯ ' --lines 15 --width 48)"
    [[ -n "$chosen" ]] || return 0
    if [[ "$chosen" == '[ Random wallpaper ]' ]]; then
        set_wallpaper "$(random_wallpaper)"
    else
        set_wallpaper "$wallpaper_dir/$chosen"
    fi
}

init_wallpaper() {
    local target=''
    if [[ "$(automation_value random_on_startup)" == "true" ]]; then
        target="$(random_wallpaper)"
    elif [[ -f "$source_file" && -f "$(cat "$source_file")" ]]; then
        target="$(cat "$source_file")"
    elif [[ -f "$current_file" && -f "$(cat "$current_file")" ]]; then
        target="$(cat "$current_file")"
    else
        target="$(random_wallpaper)"
    fi
    [[ -n "$target" ]] && set_wallpaper "$target"
    if [[ "$(automation_value cycle_enabled)" == "true" ]]; then
        start_cycle "$(automation_value interval_seconds)"
    fi
}

case "${1:-select}" in
    init) init_wallpaper ;;
    random) set_wallpaper "$(random_wallpaper)" ;;
    favorite) favorite_wallpaper "${2:-}" ;;
    slideshow) slideshow "${2:-300}" ;;
    stop-slideshow) stop_slideshow ;;
    cycle) cycle "${2:-1800}" ;;
    start-cycle) start_cycle "${2:-1800}" ;;
    stop-cycle) stop_cycle ;;
    select) select_wallpaper ;;
    set) set_wallpaper "$2" ;;
    *) echo "Usage: noir-wallpaper {init|random|select|set image|start-cycle seconds|stop-cycle}" >&2; exit 2 ;;
esac
