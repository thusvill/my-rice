#!/usr/bin/env bash
set -euo pipefail

user_home="${HOME}"
wallpaper_dir="${user_home}/Pictures/Wallpapers"
cache_dir="${XDG_CACHE_HOME:-${user_home}/.cache}/noir-rice"
current_file="$cache_dir/current-wallpaper"
pid_file="$cache_dir/swaybg.pid"
slideshow_pid_file="$cache_dir/slideshow.pid"
favorites_file="$cache_dir/favorites"
mkdir -p "$cache_dir"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send -t 2200 -a "Noir Wallpaper" "$1" "${2:-}"
}

wallpapers() {
    find "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print | sort -f
}

set_wallpaper() {
    local target="$1"
    [[ -f "$target" ]] || return 1
    if [[ -f "$pid_file" ]]; then
        kill "$(cat "$pid_file")" 2>/dev/null || true
    fi
    swaybg -i "$target" -m fill >/dev/null 2>&1 &
    echo "$!" > "$pid_file"
    printf '%s\n' "$target" > "$current_file"
    notify "Wallpaper updated" "$(basename -- "$target")"
}

random_wallpaper() {
    mapfile -t available < <(wallpapers)
    ((${#available[@]})) || return 1
    printf '%s\n' "${available[RANDOM % ${#available[@]}]}"
}

favorite_wallpaper() {
    local target="${1:-$(cat "$current_file" 2>/dev/null || true)}"
    [[ -f "$target" ]] || return 1
    touch "$favorites_file"
    grep -Fxq "$target" "$favorites_file" 2>/dev/null || printf '%s\n' "$target" >> "$favorites_file"
    notify "Wallpaper favorite saved" "$(basename -- "$target")"
}

slideshow() {
    local delay="${1:-300}"
    [[ "$delay" =~ ^[0-9]+$ ]] || delay=300
    printf '%s\n' "$$" > "$slideshow_pid_file"
    trap 'rm -f "$slideshow_pid_file"' EXIT INT TERM
    while true; do
        set_wallpaper "$(random_wallpaper)"
        sleep "$delay"
    done
}

stop_slideshow() {
    if [[ -f "$slideshow_pid_file" ]]; then
        kill "$(cat "$slideshow_pid_file")" 2>/dev/null || true
        rm -f "$slideshow_pid_file"
    fi
}

generate_ascii() {
    local source="${1:-$(random_wallpaper)}"
    local output="$cache_dir/ascii-wallpaper.png"
    local text_file="$cache_dir/ascii-wallpaper.txt"
    local converter=()
    local ascii_size="${NOIR_ASCII_SIZE:-180x90}"
    command -v chafa >/dev/null 2>&1 || { notify "ASCII wallpaper unavailable" "Install chafa"; return 1; }
    if command -v magick >/dev/null 2>&1; then
        converter=(magick)
    elif command -v convert >/dev/null 2>&1; then
        converter=(convert)
    else
        notify "ASCII wallpaper unavailable" "Install ImageMagick"; return 1
    fi
    [[ -f "$source" ]] || { notify "ASCII wallpaper unavailable" "No wallpaper image was selected"; return 1; }
    chafa --format symbols --colors 2 --size "$ascii_size" "$source" \
        | sed $'s/\033\\[[0-9;?]*[ -\/]*[@-~]//g' > "$text_file"
    "${converter[@]}" -background black -fill white -font DejaVu-Sans-Mono -pointsize 10 \
        -size 1920x1080 caption:"@$text_file" "$output"
    set_wallpaper "$output"
}

select_wallpaper() {
    local options='[ Random wallpaper ]'
    options+=$'\n'
    options+="$(wallpapers | sed "s#^$wallpaper_dir/##")"
    local chosen
    chosen="$(printf '%s\n' "$options" | fuzzel --dmenu --prompt 'Wallpaper ❯ ' --lines 15 --width 48)"
    [[ -n "$chosen" ]] || return 0
    if [[ "$chosen" == '[ Random wallpaper ]' ]]; then
        set_wallpaper "$(random_wallpaper)"
    else
        set_wallpaper "$wallpaper_dir/$chosen"
    fi
}

init_wallpaper() {
    local target=''
    if [[ -f "$current_file" && -f "$(cat "$current_file")" ]]; then
        target="$(cat "$current_file")"
    else
        target="$(random_wallpaper)"
    fi
    [[ -n "$target" ]] && set_wallpaper "$target"
}

case "${1:-select}" in
    init) init_wallpaper ;;
    random) set_wallpaper "$(random_wallpaper)" ;;
    favorite) favorite_wallpaper "${2:-}" ;;
    slideshow) slideshow "${2:-300}" ;;
    stop-slideshow) stop_slideshow ;;
    select) select_wallpaper ;;
    ascii) generate_ascii "${2:-}" ;;
    set) set_wallpaper "$2" ;;
    *) echo "Usage: noir-wallpaper {init|random|select|ascii [image]|set image}" >&2; exit 2 ;;
esac
