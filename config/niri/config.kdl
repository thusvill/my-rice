input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    mouse {
        accel-speed 0.2
        accel-profile "flat"
    }
    // Focus the window under the pointer, like Hyprland's focus-follows-mouse.
    focus-follows-mouse
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }
}

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        width 2
        active-color "#cfcfcf"
        inactive-color "#242424"
    }
    border {
        off
    }
}

prefer-no-csd
hotkey-overlay {
    skip-at-startup
}

layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur false
    }
}

// Keep the live Command+D launcher as a centered overlay, never a tiled window.
window-rule {
    match title="^Noir Launcher$"
    open-floating true
    open-focused true
    border {
        off
    }
    focus-ring {
        off
    }
}

spawn-at-startup "sh" "-c" "$HOME/.local/bin/noir-wallpaper init"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/noir-display-profile"
spawn-at-startup "waybar"
spawn-at-startup "dunst"

binds {
    // Mod is the Super/Command key for this rice.
    Mod+T { spawn "kitty"; }
    Mod+D { spawn "sh" "-c" "exec \"$HOME/.local/bin/noir-launcher\""; }
    Mod+S { spawn "sh" "-c" "$HOME/.local/bin/noir-settings"; }
    Mod+P { spawn "sh" "-c" "exec \"$HOME/.local/bin/noir-display-menu\""; }
    Mod+Escape { spawn "wlogout" "-b" "4" "-c" "16" "-r" "0" "-m" "340" "-s"; }
    Mod+L { spawn "sh" "-c" "exec \"$HOME/.local/bin/noir-lockscreen\""; }
    Mod+Ctrl+L { spawn "sh" "-c" "exec \"$HOME/.local/bin/noir-lockscreen\""; }
    Mod+W { spawn "brave"; }
    Mod+E { spawn "nautilus"; }
    Mod+Shift+W { spawn "sh" "-c" "$HOME/.local/bin/noir-wallpaper select"; }
    Mod+Ctrl+W { spawn "sh" "-c" "$HOME/.local/bin/noir-wallpaper random"; }

    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+Alt+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+BracketLeft { focus-workspace-down; }
    Mod+BracketRight { focus-workspace-up; }
    Mod+Shift+BracketLeft { move-column-to-workspace-down; }
    Mod+Shift+BracketRight { move-column-to-workspace-up; }

    Print { spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots; grim ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"; }
    Mod+Shift+S { spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots; if command -v slurp >/dev/null; then grim -g \"$(slurp)\" ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png; else grim ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png; fi"; }

    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
}
